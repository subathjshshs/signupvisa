---
interface Props { settings?: Record<string, string> }
const { settings = {} } = Astro.props;
const companyName = settings.company_name || 'Signup Visa & Migration';
const year = new Date().getFullYear();

const departments = [
  ['Support', settings.email_support || 'support@signupvisa.com'],
  ['General Info', settings.email_info || 'info@signupvisa.com'],
  ['Admissions', settings.email_admissions || 'admissions@signupvisa.com'],
  ['Processing', settings.email_processing || 'processing@signupvisa.com'],
  ['Moulvibazar Desk', settings.email_moulvibazar || 'moulvibazar@signupvisa.com'],
  ['Media', settings.email_media || 'media@signupvisa.com'],
  ['Fly / Travel', settings.email_fly || 'fly@signupvisa.com'],
  ['Partners', settings.email_partners || 'partners@signupvisa.com'],
  ['Careers', settings.email_careers || 'careers@signupvisa.com'],
  ['Admin', settings.email_admin || 'admin@signupvisa.com'],
];

const socials = [
  { name: 'LinkedIn', url: settings.linkedin_url || 'https://www.linkedin.com/company/signup-visa-migration/' },
  { name: 'Facebook', url: settings.facebook_url || 'https://www.facebook.com/signupvisa' },
  { name: 'Instagram', url: settings.instagram_url || 'https://www.instagram.com/signupvisa/' },
  { name: 'Blog', url: settings.blog_url || 'https://signupvisa.blogspot.com/' },
];
---
<footer class="border-t border-brand-line bg-brand-ink text-white/75">
  <div class="mx-auto max-w-7xl px-5 py-16">
    <div class="grid gap-12 md:grid-cols-[1.3fr_1fr_1.4fr]">
      <div>
        <span class="text-xl font-extrabold text-white">{companyName}</span>
        <p class="mt-3 max-w-xs text-sm leading-relaxed">
          {settings.tagline || 'Your trusted pathway to studying and working abroad.'}
        </p>
        <div class="mt-5 flex gap-2">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" class="group relative grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-white/5 transition-colors hover:bg-white/15" aria-label={s.name}>
              <span class="text-xs font-semibold">{s.name[0]}</span>
              <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-white px-2 py-1 text-[11px] font-medium text-brand-ink opacity-0 shadow transition-opacity group-hover:opacity-100">{s.name}</span>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="mb-4 font-mono text-xs font-semibold uppercase tracking-wider text-white/50">Explore</h3>
        <div class="flex flex-col gap-2.5 text-sm">
          <a href="/services" class="hover:text-white">Services</a>
          <a href="/destinations" class="hover:text-white">Destinations</a>
          <a href="/blog" class="hover:text-white">Blog</a>
          <a href="/about" class="hover:text-white">About Us</a>
        </div>
      </div>

      <div>
        <h3 class="mb-4 font-mono text-xs font-semibold uppercase tracking-wider text-white/50">Reach the right team</h3>
        <div class="grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
          {departments.map(([label, email]) => (
            <a href={`mailto:${email}`} class="group flex flex-col hover:text-white">
              <span class="text-white/50 text-[11px]">{label}</span>
              <span class="truncate">{email}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <span>© {year} {companyName}. All rights reserved.</span>
      {settings.phone && <span>{settings.phone}</span>}
    </div>
  </div>
</footer>
