---
import '../styles/brand.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BloggerLatest from '../components/BloggerLatest.astro';

interface Props {
  title: string;
  description?: string;
  settings?: Record<string, string>;
  noindex?: boolean;
}
const { title, description = 'Clear guidance for visas and migration pathways abroad.', settings = {}, noindex = false } = Astro.props;
const companyName = settings.company_name || 'SIGNUP Visa & Migration';
const siteUrl = 'https://signupvisa.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const isHome = Astro.url.pathname === '/';
const ogImage = new URL('/images/hero/homebanner.webp', siteUrl).toString();
const sameAs = [settings.facebook_url, settings.instagram_url, settings.linkedin_url].filter(Boolean);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: companyName,
  url: siteUrl,
  logo: ogImage,
  email: settings.email_info || 'info@signupvisa.com',
  sameAs,
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: companyName,
  url: siteUrl,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="alternate icon" href="/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title} | {companyName}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <meta name="theme-color" content="#071426" />
    <meta property="og:site_name" content={companyName} />
    <meta property="og:title" content={`${title} | ${companyName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${companyName} website`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${companyName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  </head>
  <body class="font-sans antialiased">
    <SiteNav settings={settings} />
    <main>
      <slot />
    </main>
    {isHome && <BloggerLatest limit={6} />}
    <SiteFooter settings={settings} />
  </body>
</html>
