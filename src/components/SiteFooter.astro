---
interface Props { settings?: Record<string, string> }
const { settings = {} } = Astro.props;
const companyName = settings.company_name || 'Signup Visa & Migration';
const year = new Date().getFullYear();

const socials = [
  { name: 'LinkedIn', url: settings.linkedin_url || 'https://www.linkedin.com/company/signup-visa-migration/' },
  { name: 'Facebook', url: settings.facebook_url || 'https://www.facebook.com/signupvisa' },
  { name: 'Instagram', url: settings.instagram_url || 'https://www.instagram.com/signupvisa/' },
  { name: 'Blog', url: settings.blog_url || 'https://signupvisa.blogspot.com/' },
];
---
<footer class="border-t border-brand-line bg-brand-ink text-white/75">
  <div class="mx-auto max-w-7xl px-5 py-14">
    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2">
          <img src="/images/logo/logo-footer.svg" alt={companyName} class="h-8 w-auto" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline'" />
          <span class="hidden text-lg font-extrabold text-white">{companyName}</span>
        </div>
        <p class="mt-3 max-w-xs text-sm leading-relaxed">
          {settings.tagline || 'Your trusted pathway to studying and working abroad.'}
        </p>
        <div class="mt-5 flex gap-2">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" class="group relative grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-white/5 transition-all duration-300 hover:-translate-y-1 hover:border-white/30 hover:bg-gradient-brand hover:shadow-lg hover:shadow-brand-blue/30" aria-label={s.name}>
              <span class="text-xs font-semibold">{s.name[0]}</span>
              <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-white px-2 py-1 text-[11px] font-medium text-brand-ink opacity-0 shadow transition-opacity group-hover:opacity-100">{s.name}</span>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="mb-4 font-mono text-xs font-semibold uppercase tracking-wider text-white/50">Explore</h3>
        <div class="flex flex-col gap-2.5 text-sm">
          <a href="/services" class="hover:text-white">Services</a>
          <a href="/destinations" class="hover:text-white">Destinations</a>
          <a href="/blog" class="hover:text-white">Blog</a>
          <a href="/about" class="hover:text-white">About Us</a>
          <a href="/contact" class="hover:text-white">Contact</a>
        </div>
      </div>

      <div>
        <h3 class="mb-4 font-mono text-xs font-semibold uppercase tracking-wider text-white/50">Contact</h3>
        <div class="flex flex-col gap-2.5 text-sm">
          <a href={`mailto:${settings.email_support || 'support@signupvisa.com'}`} class="hover:text-white">{settings.email_support || 'support@signupvisa.com'}</a>
          {settings.phone && <span>{settings.phone}</span>}
          {settings.address && <span>{settings.address}</span>}
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <span>© {year} {companyName}. All rights reserved.</span>
    </div>
  </div>
</footer>
