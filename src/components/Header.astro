---
interface Props { settings?: Record<string, string> }
const { settings = {} } = Astro.props;
const companyName = settings.company_name || 'Visa & Migration';
const phone = settings.phone || '';
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand">
      {settings.logo_url
        ? <img src={settings.logo_url} alt={companyName} class="brand-logo" />
        : <span class="brand-text">{companyName}</span>}
    </a>
    <nav class="nav">
      <a href="/">Home</a>
      <a href="/services">Services</a>
      <a href="/destinations">Destinations</a>
      <a href="/success-stories">Success Stories</a>
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="/contact" class="btn btn-gold nav-cta">Book Consultation</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: rgba(245,246,244,0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 74px; }
  .brand-text { font-family: var(--font-display); font-size: 1.3rem; color: var(--ink); font-weight: 600; }
  .brand-logo { height: 38px; }
  .nav { display: flex; align-items: center; gap: 26px; font-size: 0.92rem; font-weight: 500; }
  .nav a:not(.nav-cta):hover { color: var(--ink-3); }
  .nav-cta { padding: 10px 20px; font-size: 0.88rem; }
  @media (max-width: 780px) {
    .nav { gap: 14px; font-size: 0.82rem; }
    .nav a:not(.nav-cta) { display: none; }
  }
</style>
