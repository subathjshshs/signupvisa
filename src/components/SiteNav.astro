---
interface Props { settings?: Record<string, string> }
const { settings = {} } = Astro.props;
const companyName = settings.company_name || 'Signup Visa & Migration';
---
<header class="sticky top-0 z-50 border-b border-brand-line/70 bg-white/80 backdrop-blur-xl">
  <div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-5">
    <a href="/" class="flex items-center gap-2">
      <img src="/images/logo/logo-header.svg" alt={companyName} class="h-9 w-auto" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline'" />
      <span class="hidden text-xl font-extrabold text-gradient">{companyName}</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium text-brand-ink/80 md:flex">
      <div class="group relative">
        <button class="flex items-center gap-1 hover:text-brand-blue">
          Destinations
          <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
        </button>
        <div class="invisible absolute left-1/2 top-full w-44 -translate-x-1/2 pt-3 opacity-0 transition-all group-hover:visible group-hover:opacity-100">
          <div class="rounded-xl border border-brand-line bg-white p-2 shadow-xl">
            <a href="/destinations" class="block rounded-lg px-3 py-2 text-sm hover:bg-brand-accent-bg hover:text-brand-accent-text">All Destinations</a>
          </div>
        </div>
      </div>
      <a href="/services" class="hover:text-brand-blue">Services</a>
      <a href="/success-stories" class="hover:text-brand-blue">Success Stories</a>
      <a href="/blog" class="hover:text-brand-blue">Blog</a>
      <a href="/about" class="hover:text-brand-blue">About</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact" class="hidden rounded-full bg-gradient-brand px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-blue/20 transition-transform hover:-translate-y-0.5 sm:inline-flex">
        Apply Now
      </a>
      <button id="mobile-menu-btn" class="grid h-9 w-9 place-items-center rounded-lg border border-brand-line md:hidden" aria-label="Open menu">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-brand-line bg-white md:hidden">
    <div class="flex flex-col gap-1 p-4 text-sm font-medium">
      <a href="/destinations" class="rounded-lg px-3 py-2.5 hover:bg-brand-accent-bg">Destinations</a>
      <a href="/services" class="rounded-lg px-3 py-2.5 hover:bg-brand-accent-bg">Services</a>
      <a href="/success-stories" class="rounded-lg px-3 py-2.5 hover:bg-brand-accent-bg">Success Stories</a>
      <a href="/blog" class="rounded-lg px-3 py-2.5 hover:bg-brand-accent-bg">Blog</a>
      <a href="/about" class="rounded-lg px-3 py-2.5 hover:bg-brand-accent-bg">About</a>
      <a href="/contact" class="mt-2 rounded-full bg-gradient-brand px-5 py-2.5 text-center font-semibold text-white">Apply Now</a>
    </div>
  </div>
</header>

<script>
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
