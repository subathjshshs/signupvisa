---
import { getBloggerPosts } from '../lib/blogger';

interface Props {
  limit?: number;
  heading?: string;
  compact?: boolean;
}

const { limit = 6, heading = 'Latest from SIGNUP', compact = false } = Astro.props;
const posts = await getBloggerPosts(limit);

function formatDate(value: string) {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short', year: 'numeric' }).format(date);
}
---

<section class={compact ? 'border-t border-brand-line bg-white' : 'border-t border-brand-line bg-brand-surface'} aria-labelledby="latest-blog-heading">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20 lg:px-10">
    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-brand-accent-text">Insights & updates</p>
        <h2 id="latest-blog-heading" class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{heading}</h2>
        <p class="mt-3 max-w-xl text-sm leading-6 text-brand-muted">Practical visa, migration, study, work and travel information from the SIGNUP blog.</p>
      </div>
      <a href="https://blog.signupvisa.com/" class="inline-flex w-fit items-center rounded-full border border-brand-line bg-white px-5 py-2.5 text-sm font-bold text-brand-ink transition hover:border-brand-blue hover:text-brand-blue">View all articles <span class="ml-2 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span></a>
    </div>

    <div id="latest-blog-content" class="mt-10" aria-busy={posts.length === 0 ? 'true' : 'false'}>
      {posts.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="group flex h-full flex-col overflow-hidden rounded-3xl border border-brand-line bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
              <a href={post.url} target="_blank" rel="noopener noreferrer" aria-label={`Read ${post.title}`}>
                {post.imageUrl ? (
                  <img src={post.imageUrl} alt="" loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover transition duration-700 group-hover:scale-[1.02]" />
                ) : (
                  <div class="grid aspect-[16/9] w-full place-items-center bg-brand-ink text-white"><span class="text-xs font-bold uppercase tracking-[.2em] text-white/60">SIGNUP BLOG</span></div>
                )}
              </a>
              <div class="flex flex-1 flex-col p-6">
                {post.published && <time datetime={post.published} class="text-xs font-semibold uppercase tracking-wider text-brand-muted">{formatDate(post.published)}</time>}
                <h3 class="mt-2 line-clamp-2 text-lg font-extrabold leading-6"><a href={post.url} target="_blank" rel="noopener noreferrer" class="hover:text-brand-blue">{post.title}</a></h3>
                {post.excerpt && <p class="mt-3 line-clamp-3 text-sm leading-6 text-brand-muted">{post.excerpt}</p>}
                <a href={post.url} target="_blank" rel="noopener noreferrer" class="group/read mt-auto inline-flex items-center gap-1 pt-5 text-sm font-bold text-brand-blue">Read article <span class="inline-block transition-transform duration-200 group-hover/read:translate-x-1" aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div id="latest-blog-empty" class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" role="status" aria-live="polite" aria-label="Loading latest articles">
          {Array.from({ length: Math.min(Number(limit), 3) }).map(() => (
            <div class="overflow-hidden rounded-3xl border border-brand-line bg-white shadow-sm" aria-hidden="true">
              <div class="aspect-[16/9] w-full animate-pulse bg-brand-surface"></div>
              <div class="space-y-3 p-6">
                <div class="h-3 w-20 animate-pulse rounded-full bg-brand-surface"></div>
                <div class="h-5 w-11/12 animate-pulse rounded-full bg-brand-surface"></div>
                <div class="h-4 w-full animate-pulse rounded-full bg-brand-surface"></div>
                <div class="h-4 w-3/4 animate-pulse rounded-full bg-brand-surface"></div>
                <div class="h-4 w-24 animate-pulse rounded-full bg-brand-accent-bg"></div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

{posts.length === 0 && (
  <script define:vars={{ limit }}>
    const callbackName = `__signupBloggerFeed_${Math.random().toString(36).slice(2)}`;
    const feedUrl = `https://www.blogger.com/feeds/7169008174680734865/posts/default?alt=json-in-script&max-results=${Math.min(Number(limit), 12)}&callback=${callbackName}`;

    function stripHtml(value = '') {
      const el = document.createElement('div');
      el.innerHTML = value;
      return (el.textContent || el.innerText || '').replace(/\s+/g, ' ').trim();
    }

    function imageFromHtml(html = '') {
      const match = html.match(/<img[^>]+(?:src|data-src)=["']([^"']+)["']/i);
      return match?.[1] || '';
    }

    function upgradeImage(url = '') {
      return url
        .replace(/\/s(\d+)(?:-c)?\//i, '/s1200/')
        .replace(/=s\d+(?:-c)?(?:-[a-z]+)?$/i, '=s1200');
    }

    function formatDate(value) {
      if (!value) return '';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      return new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short', year: 'numeric' }).format(date);
    }

    function renderPosts(data) {
      const entries = Array.isArray(data?.feed?.entry) ? data.feed.entry : [];
      const posts = entries.map((entry) => {
        const html = entry?.content?.$t || entry?.summary?.$t || '';
        const alternate = Array.isArray(entry?.link) ? entry.link.find((link) => link?.rel === 'alternate') : null;
        return {
          title: stripHtml(entry?.title?.$t || 'Untitled article'),
          url: alternate?.href || 'https://blog.signupvisa.com/',
          published: entry?.published?.$t || entry?.updated?.$t || '',
          excerpt: stripHtml(html).slice(0, 180),
          imageUrl: upgradeImage(entry?.media$thumbnail?.url || imageFromHtml(html)),
        };
      }).sort((a, b) => new Date(b.published).getTime() - new Date(a.published).getTime()).slice(0, Number(limit));

      if (!posts.length) return;

      const content = document.getElementById('latest-blog-content');
      if (!content) return;

      const grid = document.createElement('div');
      grid.className = 'grid gap-5 md:grid-cols-2 lg:grid-cols-3';

      posts.forEach((post) => {
        const article = document.createElement('article');
        article.className = 'group flex h-full flex-col overflow-hidden rounded-3xl border border-brand-line bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl';

        const imageLink = document.createElement('a');
        imageLink.href = post.url;
        imageLink.target = '_blank';
        imageLink.rel = 'noopener noreferrer';
        imageLink.setAttribute('aria-label', `Read ${post.title}`);

        if (post.imageUrl) {
          const image = document.createElement('img');
          image.src = post.imageUrl;
          image.alt = '';
          image.loading = 'lazy';
          image.decoding = 'async';
          image.className = 'aspect-[16/9] w-full object-cover transition duration-700 group-hover:scale-[1.02]';
          imageLink.appendChild(image);
        } else {
          const fallback = document.createElement('div');
          fallback.className = 'grid aspect-[16/9] w-full place-items-center bg-brand-ink text-white';
          fallback.innerHTML = '<span class="text-xs font-bold uppercase tracking-[.2em] text-white/60">SIGNUP BLOG</span>';
          imageLink.appendChild(fallback);
        }

        const body = document.createElement('div');
        body.className = 'flex flex-1 flex-col p-6';

        if (post.published) {
          const time = document.createElement('time');
          time.dateTime = post.published;
          time.className = 'text-xs font-semibold uppercase tracking-wider text-brand-muted';
          time.textContent = formatDate(post.published);
          body.appendChild(time);
        }

        const title = document.createElement('h3');
        title.className = 'mt-2 line-clamp-2 text-lg font-extrabold leading-6';
        const titleLink = document.createElement('a');
        titleLink.href = post.url;
        titleLink.target = '_blank';
        titleLink.rel = 'noopener noreferrer';
        titleLink.className = 'hover:text-brand-blue';
        titleLink.textContent = post.title;
        title.appendChild(titleLink);
        body.appendChild(title);

        if (post.excerpt) {
          const excerpt = document.createElement('p');
          excerpt.className = 'mt-3 line-clamp-3 text-sm leading-6 text-brand-muted';
          excerpt.textContent = post.excerpt;
          body.appendChild(excerpt);
        }

        const readLink = document.createElement('a');
        readLink.href = post.url;
        readLink.target = '_blank';
        readLink.rel = 'noopener noreferrer';
        readLink.className = 'group/read mt-auto inline-flex items-center gap-1 pt-5 text-sm font-bold text-brand-blue';
        readLink.innerHTML = 'Read article <span aria-hidden="true" class="inline-block transition-transform duration-200">→</span>';
        readLink.addEventListener('mouseenter', () => readLink.querySelector('span')?.classList.add('translate-x-1'));
        readLink.addEventListener('mouseleave', () => readLink.querySelector('span')?.classList.remove('translate-x-1'));
        body.appendChild(readLink);

        article.append(imageLink, body);
        grid.appendChild(article);
      });

      content.replaceChildren(grid);
      content.setAttribute('aria-busy', 'false');
    }

    window[callbackName] = renderPosts;
    const script = document.createElement('script');
    script.src = feedUrl;
    script.async = true;
    script.onerror = () => {
      try { delete window[callbackName]; } catch {}
    };
    document.head.appendChild(script);
    window.setTimeout(() => {
      try { delete window[callbackName]; } catch {}
      script.remove();
    }, 8000);
  </script>
)}