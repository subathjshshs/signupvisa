---
import { getBloggerPosts } from '../lib/blogger';

interface Props {
  limit?: number;
  heading?: string;
  compact?: boolean;
}

const { limit = 6, heading = 'Latest from SIGNUP', compact = false } = Astro.props;
const posts = await getBloggerPosts(limit);

function formatDate(value: string) {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short', year: 'numeric' }).format(date);
}
---

<section class={compact ? 'border-t border-brand-line bg-white' : 'border-t border-brand-line bg-brand-surface'}>
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-10">
    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-brand-accent-text">Insights & updates</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">{heading}</h2>
      </div>
      <a href="https://blog.signupvisa.com/" class="text-sm font-bold text-brand-blue hover:underline">View all articles →</a>
    </div>

    {posts.length > 0 ? (
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a href={post.url} class="group overflow-hidden rounded-3xl border border-brand-line bg-white transition-all hover:-translate-y-1 hover:shadow-xl" target="_blank" rel="noopener noreferrer">
            {post.imageUrl ? (
              <img src={post.imageUrl} alt="" loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover transition duration-700 group-hover:scale-[1.02]" />
            ) : (
              <div class="grid aspect-[16/9] w-full place-items-center bg-brand-ink text-white"><span class="text-xs font-bold uppercase tracking-[.2em] text-white/60">SIGNUP</span></div>
            )}
            <div class="p-6">
              {post.published && <time datetime={post.published} class="text-xs font-semibold uppercase tracking-wider text-brand-muted">{formatDate(post.published)}</time>}
              <h3 class="mt-2 line-clamp-2 text-lg font-extrabold leading-6">{post.title}</h3>
              {post.excerpt && <p class="mt-2 line-clamp-3 text-sm leading-6 text-brand-muted">{post.excerpt}</p>}
              <span class="mt-5 inline-block text-sm font-bold text-brand-blue">Read article →</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="mt-10 rounded-3xl border border-brand-line bg-white p-8 text-center">
        <p class="text-sm text-brand-muted">Latest articles will appear here from the SIGNUP blog.</p>
        <a href="https://blog.signupvisa.com/" class="mt-4 inline-flex rounded-full bg-brand-ink px-5 py-2.5 text-sm font-bold text-white">Visit the blog →</a>
      </div>
    )}
  </div>
</section>
