---
interface Props {
  testimonial: {
    client_name: string;
    visa_type: string;
    country: string;
    quote: string;
    avatar_url?: string;
  };
}
const { testimonial } = Astro.props;
---

<div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 flex flex-col justify-between">
  <p class="text-slate-700 italic text-sm leading-relaxed">"{testimonial.quote}"</p>
  <div class="mt-6 flex items-center gap-4">
    {testimonial.avatar_url ? (
      <img src={testimonial.avatar_url} alt={testimonial.client_name} class="w-12 h-12 rounded-full object-cover" />
    ) : (
      <div class="w-12 h-12 rounded-full bg-amber-500 flex items-center justify-center font-bold text-white">
        {testimonial.client_name.charAt(0)}
      </div>
    )}
    <div>
      <h4 class="font-bold text-slate-900 text-sm">{testimonial.client_name}</h4>
      <p class="text-xs text-slate-500">{testimonial.visa_type} &bull; {testimonial.country}</p>
    </div>
  </div>
</div>