---
interface Props { settings?: Record<string, string> }
const { settings = {} } = Astro.props;
const companyName = settings.company_name || 'Visa & Migration';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container foot-grid">
    <div>
      <span class="brand-text">{companyName}</span>
      <p class="tagline">{settings.tagline || 'Your trusted pathway to studying and working abroad.'}</p>
    </div>
    <div>
      <h3 class="foot-head">Explore</h3>
      <a href="/services">Services</a>
      <a href="/destinations">Destinations</a>
      <a href="/blog">Blog</a>
      <a href="/about">About Us</a>
    </div>
    <div>
      <h3 class="foot-head">Get in touch</h3>
      {settings.phone && <p>{settings.phone}</p>}
      {settings.email && <p>{settings.email}</p>}
      {settings.address && <p>{settings.address}</p>}
      <a href="/contact" class="btn btn-outline-light" style="margin-top:12px;">Book a Consultation</a>
    </div>
  </div>
  <div class="container copyright">
    <span>© {year} {companyName}. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: rgba(255,255,255,0.75); padding: 64px 0 24px; margin-top: 80px; }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; }
  .brand-text { font-family: var(--font-display); font-size: 1.25rem; color: var(--white); font-weight: 600; }
  .tagline { margin-top: 10px; font-size: 0.9rem; max-width: 30ch; }
  .foot-head { color: var(--white); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; font-family: var(--font-mono); font-weight: 500; margin-bottom: 14px; }
  .site-footer a, .site-footer p { display: block; font-size: 0.9rem; margin-bottom: 8px; color: rgba(255,255,255,0.7); }
  .site-footer a:hover { color: var(--white); }
  .copyright { border-top: 1px solid rgba(255,255,255,0.12); margin-top: 40px; padding-top: 20px; font-size: 0.8rem; }
  @media (max-width: 780px) { .foot-grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
