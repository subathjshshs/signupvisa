---
interface Props { active?: string }
const { active = '' } = Astro.props;
const links = [
  ['', 'Dashboard'],
  ['services', 'Services'],
  ['destinations', 'Destinations'],
  ['testimonials', 'Testimonials'],
  ['blog', 'Blog'],
  ['leads', 'Leads'],
  ['settings', 'Settings'],
];
---
<nav class="admin-nav">
  <div style="display:flex; gap:20px; align-items:center;">
    <strong style="font-family:var(--font-display);">Admin</strong>
    {links.map(([slug, label]) => (
      <a href={`/admin/${slug}`} class={active === slug ? 'active' : ''}>{label}</a>
    ))}
  </div>
  <button id="logout-btn" class="btn btn-outline-light" style="padding:6px 16px; font-size:0.85rem;">Log Out</button>
</nav>
<script>
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/admin/logout', { method: 'POST' });
    window.location.href = '/admin/login';
  });
</script>
