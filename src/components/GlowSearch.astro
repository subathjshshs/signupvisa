---
interface Props { placeholder?: string }
const { placeholder = 'Search a country — Australia, Canada, UK...' } = Astro.props;
---
<div class="glow-search relative mx-auto w-full max-w-xl">
  <div class="glow-search__border absolute -inset-[2px] rounded-full opacity-70 blur-md"></div>
  <div class="relative flex items-center gap-3 rounded-full bg-white px-5 py-3.5 shadow-xl">
    <svg class="h-5 w-5 text-brand-muted" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" /></svg>
    <input
      type="text"
      id="country-search"
      placeholder={placeholder}
      class="w-full border-none bg-transparent text-sm text-brand-ink outline-none placeholder:text-brand-muted"
    />
    <button class="rounded-full bg-gradient-brand px-4 py-2 text-xs font-semibold text-white shrink-0">Search</button>
  </div>
</div>

<style>
  .glow-search__border {
    background: linear-gradient(90deg, var(--color-brand-blue), var(--color-brand-purple), var(--color-brand-blue));
    background-size: 200% 100%;
    animation: glow-move 3s linear infinite;
  }
  @keyframes glow-move {
    to { background-position: 200% 0; }
  }
</style>

<script>
  const input = document.getElementById('country-search') as HTMLInputElement;
  const cards = document.querySelectorAll<HTMLElement>('[data-country-name]');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    cards.forEach((card) => {
      const name = card.dataset.countryName?.toLowerCase() || '';
      card.style.display = !q || name.includes(q) ? '' : 'none';
    });
  });
</script>
