---
// src/components/Hero.astro
---

<section class="relative min-h-screen bg-slate-950 text-white flex flex-col justify-between overflow-hidden">
  <!-- Background Image with Dark Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero/home-airport-hero.webp" 
      alt="International travel and study abroad gateway" 
      class="w-full h-full object-cover opacity-30"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-950/40"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 pt-36 pb-20 flex-1 flex flex-col justify-center">
    <div class="max-w-3xl space-y-6">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight leading-tight">
        Gateway to Global Opportunities: <span class="text-amber-400">Expert Visa & Migration</span> Solutions
      </h1>
      <p class="text-lg md:text-xl text-slate-300 max-w-2xl">
        Navigating your path to international study, work, and settlement with expert, certified guidance.
      </p>
      
      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-4 pt-4">
        <a 
          href="#contact" 
          class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-8 py-3.5 rounded-lg transition duration-200 shadow-lg"
        >
          START VISA PROCESS
        </a>
        <a 
          href="#services" 
          class="bg-slate-800/80 hover:bg-slate-700/80 border border-slate-600 text-white font-semibold px-8 py-3.5 rounded-lg backdrop-blur-sm transition duration-200"
        >
          EXPLORE PR & MIGRATION
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Trust & Accreditation Bar -->
  <div class="relative z-10 border-t border-slate-800 bg-slate-900/80 backdrop-blur-md py-6 px-6">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-around items-center gap-6 text-xs md:text-sm text-slate-300 font-medium">
      <div class="flex items-center gap-3">
        <img src="/images/trust/badge-global-consultant.svg" alt="" class="w-6 h-6" />
        <span>GLOBAL ACCREDITED CONSULTANTS</span>
      </div>
      <div class="flex items-center gap-3">
        <img src="/images/trust/badge-univ-alliance.svg" alt="" class="w-6 h-6" />
        <span>OVERSEAS UNIV. ALLIANCE</span>
      </div>
      <div class="flex items-center gap-3">
        <img src="/images/trust/badge-visa-certified.svg" alt="" class="w-6 h-6" />
        <span>VISA BOARD CERTIFIED</span>
      </div>
      <div class="flex items-center gap-3">
        <img src="/images/trust/badge-migration-alliance.svg" alt="" class="w-6 h-6" />
        <span>MIGRATION ALLIANCE</span>
      </div>
    </div>
  </div>
</section>