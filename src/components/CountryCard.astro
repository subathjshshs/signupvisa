---
import { DESTINATION_IMAGES, resolveImage } from '../lib/images';

interface Props {
  slug: string;
  name: string;
  flag?: string;
  summary?: string;
  imageUrl?: string;
}
const { slug, name, flag = '', summary = '', imageUrl = '' } = Astro.props;
const finalImage = resolveImage(DESTINATION_IMAGES, slug) || resolveImage(DESTINATION_IMAGES, name) || imageUrl;
---
<a
  href={`/destinations/${slug}`}
  class="tilt-card group relative block h-44 overflow-hidden rounded-2xl border border-brand-line shadow-sm [perspective:1000px]"
  data-country-name={name}
>
  <div class="tilt-inner absolute inset-0 flex items-center justify-center bg-gradient-brand text-5xl transition-transform duration-500 ease-out" style={finalImage ? `background-image:url(${finalImage});background-size:cover;background-position:center;` : ''}>
    {!finalImage && flag}
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent transition-opacity duration-300 group-hover:from-black/85"></div>
  <div class="absolute inset-x-0 bottom-0 p-4">
    <span class="block text-sm font-bold text-white drop-shadow">{flag} {name}</span>
    {summary && <span class="mt-0.5 block truncate text-xs text-white/75">{summary}</span>}
  </div>
</a>

<script>
  document.querySelectorAll<HTMLElement>('.tilt-card').forEach((card) => {
    const inner = card.querySelector<HTMLElement>('.tilt-inner');
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      card.style.transform = `translateY(-6px) rotateY(${x * 14}deg) rotateX(${-y * 10}deg)`;
      card.style.boxShadow = `${-x * 16}px ${-y * 8}px 32px rgba(11,20,36,0.18)`;
      if (inner) inner.style.transform = `scale(1.08)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
      card.style.boxShadow = '';
      if (inner) inner.style.transform = '';
    });
  });
</script>
