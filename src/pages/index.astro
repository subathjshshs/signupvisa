---
import SiteLayout from '../layouts/SiteLayout.astro';
import BloggerLatest from '../components/BloggerLatest.astro';
import { destinations } from '../data/destinations';
import { getSiteSettings } from '../data/site-config';
import { HERO_IMAGE, SERVICE_IMAGES } from '../lib/images';

const settings = getSiteSettings();
const destinationHighlights = destinations.slice(0, 5);

const valuePoints = [
  { number: '01', title: 'Clear guidance', text: 'Understand your options before you commit to a pathway.' },
  { number: '02', title: 'Profile-focused planning', text: 'Recommendations shaped around your goals, background and destination.' },
  { number: '03', title: 'Document support', text: 'Stay organised with practical application and document guidance.' },
  { number: '04', title: 'Step-by-step communication', text: 'Know what comes next throughout your application journey.' },
];

const process = [
  { number: '01', title: 'Tell us your goal', text: 'Share whether you want to study, work, migrate or visit abroad.' },
  { number: '02', title: 'Assess your pathway', text: 'We help you understand suitable destinations, visa routes and requirements.' },
  { number: '03', title: 'Prepare your application', text: 'Organise the relevant documents and application steps with structured support.' },
  { number: '04', title: 'Move to the next stage', text: 'Stay informed as you progress toward your planned international journey.' },
];
---

<SiteLayout
  title="Visa & Migration Consultancy"
  description="SIGNUP Visa & Migration provides structured guidance for student visas, work permits, skilled migration and visit visas across leading international destinations."
  settings={settings}
>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-brand-ink text-white">
    <img src={HERO_IMAGE} alt="International destination and travel" class="absolute inset-0 -z-30 h-full w-full object-cover" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,rgba(5,12,25,.97)_0%,rgba(5,12,25,.86)_42%,rgba(5,12,25,.42)_100%)]"></div>
    <div class="absolute inset-0 -z-20 bg-[linear-gradient(0deg,rgba(5,12,25,.88)_0%,transparent_55%)]"></div>

    <div class="mx-auto max-w-7xl px-5 pb-20 pt-16 sm:px-8 sm:pb-24 sm:pt-20 lg:px-10 lg:pt-24">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-[11px] font-bold uppercase tracking-[.17em] text-white/90 backdrop-blur-md">
          <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
          Visa & Migration Guidance
        </div>
        <h1 class="mt-7 max-w-4xl text-4xl font-extrabold leading-[1.02] tracking-[-.045em] sm:text-6xl lg:text-[5.2rem]">Plan your journey.<br /><span class="text-white/65">Choose your pathway.</span></h1>
        <p class="mt-7 max-w-2xl text-base leading-7 text-white/75 sm:text-lg sm:leading-8">Professional guidance for studying, working, visiting and building a future abroad — with a clearer process from your first enquiry to your next step.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/contact#enquiry" class="inline-flex items-center justify-center rounded-full bg-white px-7 py-3.5 text-sm font-bold text-brand-ink shadow-xl transition hover:-translate-y-0.5 hover:bg-white/90">Book a consultation <span class="ml-2">→</span></a>
          <a href="/destinations" class="inline-flex items-center justify-center rounded-full border border-white/25 bg-white/5 px-7 py-3.5 text-sm font-bold text-white backdrop-blur-sm transition hover:bg-white/10">Explore destinations</a>
        </div>
      </div>

      <div class="mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {valuePoints.map((point) => (
          <div class="rounded-2xl border border-white/15 bg-white/[.08] p-5 backdrop-blur-md">
            <div class="flex items-center justify-between"><span class="font-mono text-[11px] font-bold text-white/45">{point.number}</span><span class="h-1.5 w-1.5 rounded-full bg-white/60"></span></div>
            <h2 class="mt-5 text-base font-bold">{point.title}</h2>
            <p class="mt-1.5 text-xs leading-5 text-white/60">{point.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DESTINATION SHORTCUTS -->
  <section class="border-b border-brand-line bg-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-7 sm:px-8 lg:flex-row lg:items-center lg:px-10">
      <div class="shrink-0"><p class="text-[11px] font-bold uppercase tracking-[.17em] text-brand-muted">Explore destinations</p></div>
      <div class="grid flex-1 grid-cols-2 gap-2 sm:grid-cols-5">
        {destinationHighlights.map((destination) => (
          <a href={`/destinations/${destination.slug}`} class="group flex items-center gap-2 rounded-xl border border-brand-line px-3 py-3 transition hover:border-brand-blue hover:bg-brand-accent-bg">
            <span class="text-lg" aria-hidden="true">{destination.flag}</span>
            <span class="min-w-0 truncate text-xs font-bold text-brand-ink">{destination.name}</span>
            <span class="ml-auto text-brand-muted transition group-hover:translate-x-0.5">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- INTRO / TRUST -->
  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-brand-accent-text">Why SIGNUP</p>
        <h2 class="mt-3 max-w-2xl text-3xl font-extrabold leading-tight tracking-[-.025em] sm:text-5xl">A more organised way to plan your move abroad.</h2>
      </div>
      <p class="max-w-xl text-sm leading-7 text-brand-muted sm:text-base">International applications can involve many decisions. We make the journey easier to understand by connecting your goal with a practical pathway, clear requirements and structured application support.</p>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-brand-line bg-brand-line sm:grid-cols-2 lg:grid-cols-4">
      {valuePoints.map((point) => (
        <div class="bg-white p-7 sm:p-8">
          <span class="font-mono text-xs font-bold text-brand-accent-text">{point.number}</span>
          <h3 class="mt-8 text-lg font-bold">{point.title}</h3>
          <p class="mt-2 text-sm leading-6 text-brand-muted">{point.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- DESTINATIONS -->
  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-10">
    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-brand-accent-text">Global pathways</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Where could your journey take you?</h2>
      </div>
      <a href="/destinations" class="text-sm font-bold text-brand-blue hover:underline">Explore all destinations →</a>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {destinationHighlights.map((destination) => (
        <a href={`/destinations/${destination.slug}`} class="group relative min-h-[310px] overflow-hidden rounded-2xl bg-brand-ink text-white shadow-sm">
          <img src={destination.imageUrl} alt={`${destination.name} destination`} class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,12,25,.04),rgba(5,12,25,.9))]"></div>
          <div class="relative flex h-full min-h-[310px] flex-col justify-end p-5">
            <span class="text-2xl" aria-hidden="true">{destination.flag}</span>
            <h3 class="mt-2 text-lg font-extrabold">{destination.name}</h3>
            <p class="mt-1 text-xs leading-5 text-white/65">{destination.summary}</p>
            <span class="mt-4 text-xs font-bold uppercase tracking-wider text-white/90">Explore pathway →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- PROCESS -->
  <section class="bg-brand-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-10">
      <div class="grid gap-12 lg:grid-cols-[.75fr_1.25fr]">
        <div>
          <p class="text-xs font-bold uppercase tracking-[.18em] text-brand-accent-text">How it works</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Four practical steps.<br />One clearer journey.</h2>
          <p class="mt-5 max-w-md text-sm leading-7 text-brand-muted">Start with your goal and work through the pathway in a structured way, without losing sight of the next action.</p>
          <a href="/contact#enquiry" class="mt-7 inline-flex rounded-full bg-brand-ink px-6 py-3 text-sm font-bold text-white transition hover:-translate-y-0.5">Start your enquiry →</a>
        </div>
        <div class="divide-y divide-brand-line rounded-3xl border border-brand-line bg-white">
          {process.map((item) => (
            <div class="grid gap-4 px-6 py-7 sm:grid-cols-[72px_1fr] sm:px-8">
              <span class="font-mono text-xs font-bold text-brand-accent-text">{item.number}</span>
              <div><h3 class="text-lg font-bold">{item.title}</h3><p class="mt-1.5 max-w-xl text-sm leading-6 text-brand-muted">{item.text}</p></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE IMAGE / APPLICATION SUPPORT -->
  <section class="px-5 py-20 sm:px-8 sm:py-24 lg:px-10">
    <div class="mx-auto grid max-w-7xl overflow-hidden rounded-[2rem] bg-brand-ink text-white lg:grid-cols-[1fr_1fr]">
      <div class="relative min-h-[350px] lg:min-h-[460px]">
        <img src={SERVICE_IMAGES['student-visa']} alt="Student visa application guidance" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/45 to-transparent"></div>
      </div>
      <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-14">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-white/55">Application support</p>
        <h2 class="mt-3 max-w-xl text-3xl font-extrabold tracking-tight sm:text-4xl">From first enquiry to a well-prepared application.</h2>
        <p class="mt-5 max-w-xl text-sm leading-7 text-white/65 sm:text-base">Get practical support with pathway decisions, documentation and application preparation. The goal is simple: make each stage easier to understand and manage.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/services/student-visa" class="inline-flex justify-center rounded-full bg-white px-6 py-3.5 text-sm font-bold text-brand-ink transition hover:bg-white/90">Student Visa</a>
          <a href="/services" class="inline-flex justify-center rounded-full border border-white/20 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-white/10">All services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <BloggerLatest limit={3} heading="Latest Articles" />

  <!-- FINAL CTA -->
  <section class="border-t border-brand-line bg-white">
    <div class="mx-auto max-w-5xl px-5 py-20 text-center sm:px-8 sm:py-24">
      <p class="text-xs font-bold uppercase tracking-[.18em] text-brand-accent-text">Your next step</p>
      <h2 class="mx-auto mt-3 max-w-3xl text-3xl font-extrabold tracking-[-.025em] sm:text-5xl">Have a destination in mind?</h2>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-brand-muted sm:text-base">Tell us what you want to achieve abroad. We’ll help you understand the available pathway, requirements and practical next step.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/contact#enquiry" class="inline-flex items-center justify-center rounded-full bg-gradient-brand px-8 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-blue/20 transition hover:-translate-y-0.5">Book a consultation →</a>
        <a href="mailto:info@signupvisa.com" class="inline-flex items-center justify-center rounded-full border border-brand-line bg-white px-8 py-3.5 text-sm font-bold text-brand-ink transition hover:border-brand-blue">Email our team</a>
      </div>
    </div>
  </section>
</SiteLayout>
