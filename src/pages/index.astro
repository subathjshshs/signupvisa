---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import DestinationCard from '../components/DestinationCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

// Fallback Mock Data for Local Preview
const fallbackServices = [
  {
    id: 1,
    title: "Student Visa Assistance",
    slug: "student-visa",
    short_description: "End-to-end guidance for university applications, offer letters, and student visa lodgement.",
    icon: "academic-cap",
    image_url: "/images/services/service-student-visa.webp"
  },
  {
    id: 2,
    title: "Skilled & Work Migration",
    slug: "work-visa",
    short_description: "Expert point assessment and documentation support for skilled worker visas.",
    icon: "briefcase",
    image_url: "/images/services/service-work-visa.webp"
  },
  {
    id: 3,
    title: "PR & Permanent Residency",
    slug: "pr-residency",
    short_description: "Strategic pathways to secure permanent residency and family reunification abroad.",
    icon: "globe-alt",
    image_url: "/images/services/service-skilled-migration.webp"
  }
];

const fallbackDestinations = [
  { id: 1, name: "United Kingdom", slug: "uk", flag_code: "gb", image_url: "/images/destinations/dest-uk.webp", popular_courses: "Business, Tech, Nursing" },
  { id: 2, name: "Australia", slug: "australia", flag_code: "au", image_url: "/images/destinations/dest-australia.webp", popular_courses: "Engineering, IT, Public Health" },
  { id: 3, name: "Canada", slug: "canada", flag_code: "ca", image_url: "/images/destinations/dest-canada.webp", popular_courses: "Data Science, Management, Hospitality" },
  { id: 4, name: "United States", slug: "usa", flag_code: "us", image_url: "/images/destinations/dest-usa.webp", popular_courses: "STEM, Finance, Biotechnology" }
];

const fallbackTestimonials = [
  {
    id: 1,
    client_name: "Rahim Ahmed",
    visa_type: "Student Visa (Subclass 500)",
    country: "Australia",
    quote: "Signup Visa made my Australian student visa process completely stress-free. From document preparation to lodgement, everything was smooth.",
    avatar_url: "/images/team/student-01.webp"
  },
  {
    id: 2,
    client_name: "Tanjina Akter",
    visa_type: "Student Route Visa",
    country: "United Kingdom",
    quote: "Got my CAS letter and visa approval within record time! Exceptional guidance throughout the university shortlisting process.",
    avatar_url: "/images/team/student-02.webp"
  },
  {
    id: 3,
    client_name: "Mahmud Hasan",
    visa_type: "Skilled Worker Visa",
    country: "Canada",
    quote: "The team analyzed my profile carefully and helped me secure my work permit hassle-free. Highly recommended consultancy!",
    avatar_url: "/images/team/student-03.webp"
  }
];

// Combine DB results with fallbacks
let services = [];
let destinations = [];
let testimonials = [];

try {
  // Dynamic Cloudflare D1 fetch logic executes here in production
} catch (e) {
  // Default to fallbacks on error or empty local DB
}

if (!services || services.length === 0) services = fallbackServices;
if (!destinations || destinations.length === 0) destinations = fallbackDestinations;
if (!testimonials || testimonials.length === 0) testimonials = fallbackTestimonials;
---

<Layout title="Home">
  <Hero />
  
  <!-- Services Grid Section -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-slate-900">Our Core Visa Services</h2>
        <p class="mt-4 text-slate-600">Tailored migration solutions managed by certified immigration advisors.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <!-- Destinations Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-slate-900">Top Study & Work Destinations</h2>
        <p class="mt-4 text-slate-600">Explore global opportunities across leading international hubs.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {destinations.map((dest) => (
          <DestinationCard destination={dest} />
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-16 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-white">Success Stories</h2>
        <p class="mt-4 text-slate-400">Hear from our clients who successfully moved abroad.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-slate-900">
        {testimonials.map((item) => (
          <TestimonialCard testimonial={item} />
        ))}
      </div>
    </div>
  </section>
</Layout>