---
import Layout from '../layouts/Layout.astro';
import { getSettings, getServices, getDestinations, getTestimonials } from '../lib/content';

const db = Astro.locals.runtime?.DB;
const settings = db ? await getSettings(db) : {};
const services = db ? await getServices(db, { featuredOnly: false }) : [];
const destinations = db ? await getDestinations(db, { featuredOnly: true }) : [];
const testimonials = db ? await getTestimonials(db, 3) : [];
---
<Layout title="Home" settings={settings}>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="badge-stamp">Licensed Visa &amp; Migration Consultancy</span>
        <h1 style="margin-top:18px;">{settings.tagline || 'Your trusted pathway to studying and working abroad'}</h1>
        <p class="hero-sub">
          From your first question to the day you land — we handle university selection, documentation,
          and visa lodgement so your journey abroad starts on solid ground.
        </p>
        <div class="hero-ctas">
          <a href="/contact" class="btn btn-primary">Book a Free Consultation</a>
          <a href="/services" class="btn btn-outline">Explore Services</a>
        </div>
      </div>
      <div class="hero-image">
        {settings.hero_image_url
          ? <img src={settings.hero_image_url} alt="Students starting their journey abroad" />
          : <div class="hero-placeholder">Upload a hero image from the admin panel</div>}
      </div>
    </div>

    <!-- Signature route-line: the real journey a student takes -->
    <div class="container">
      <div class="route-line">
        <div class="route-stop">
          <span class="route-label-num">01</span>
          <div class="route-dot"></div>
          <strong>Consultation</strong>
          <p class="route-copy">We understand your goals, budget, and background.</p>
        </div>
        <div class="route-stop">
          <span class="route-label-num">02</span>
          <div class="route-dot"></div>
          <strong>Application</strong>
          <p class="route-copy">University shortlisting, documentation, and submission.</p>
        </div>
        <div class="route-stop">
          <span class="route-label-num">03</span>
          <div class="route-dot"></div>
          <strong>Visa Filing</strong>
          <p class="route-copy">Complete visa preparation and interview readiness.</p>
        </div>
        <div class="route-stop is-final">
          <span class="route-label-num">04</span>
          <div class="route-dot"></div>
          <strong>Departure</strong>
          <p class="route-copy">Pre-departure briefing — and you're on your way.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">What we do</span>
      <h2>Our services</h2>
      <p class="section-lead">We're starting with student visa processing — and building toward work visas, skilled migration, and visit visas.</p>
      <div class="grid-3" style="margin-top:40px;">
        {services.length > 0 ? services.map((s: any) => (
          <a href={`/services/${s.slug}`} class="card service-card">
            <h3>{s.name}</h3>
            <p>{s.tagline}</p>
            <span class="card-link">Learn more →</span>
          </a>
        )) : (
          <div class="card"><p>Add your services from the admin panel — they'll appear here automatically.</p></div>
        )}
      </div>
    </div>
  </section>

  <!-- DESTINATIONS -->
  {destinations.length > 0 && (
    <section class="section section-dark">
      <div class="container">
        <span class="eyebrow">Where you can go</span>
        <h2>Popular destinations</h2>
        <div class="grid-3" style="margin-top:40px;">
          {destinations.map((d: any) => (
            <a href={`/destinations/${d.slug}`} class="card dest-card">
              <h3>{d.flag_emoji} {d.country_name}</h3>
              <p>{d.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- TESTIMONIALS -->
  {testimonials.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Success stories</span>
        <h2>What our students say</h2>
        <div class="grid-3" style="margin-top:40px;">
          {testimonials.map((t: any) => (
            <div class="card">
              <p class="quote">"{t.quote}"</p>
              <strong>{t.student_name}</strong>
              {t.destination && <span class="quote-dest"> — {t.destination}</span>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA BAND -->
  <section class="section-tight cta-band">
    <div class="container cta-inner">
      <h2>Ready to start your journey?</h2>
      <a href="/contact" class="btn btn-gold">Book a Free Consultation</a>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 56px 0 0; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; }
  .hero-sub { font-size: 1.08rem; color: var(--text-muted); max-width: 46ch; margin: 20px 0 30px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-placeholder {
    aspect-ratio: 4/3; background: var(--paper-dim); border: 1px dashed var(--line);
    display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 0.85rem; text-align:center; padding: 20px;
  }
  .hero-image img { border-radius: var(--radius); aspect-ratio: 4/3; object-fit: cover; }
  .route-copy { font-size: 0.85rem; color: var(--text-muted); margin: 6px 0 0; }
  .section-lead { color: var(--text-muted); max-width: 60ch; margin-top: 10px; }
  .service-card, .dest-card { transition: transform .15s ease, box-shadow .15s ease; }
  .service-card:hover, .dest-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(14,34,55,0.08); }
  .card-link { display: inline-block; margin-top: 14px; font-size: 0.85rem; color: var(--gold); font-weight: 600; }
  .section-dark .card { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.14); color: rgba(255,255,255,0.85); }
  .section-dark .card h3 { color: var(--white); }
  .quote { font-family: var(--font-display); font-size: 1.05rem; color: var(--ink); margin-bottom: 14px; }
  .quote-dest { color: var(--text-muted); font-size: 0.9rem; }
  .cta-band { background: var(--paper-dim); }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }
</style>
