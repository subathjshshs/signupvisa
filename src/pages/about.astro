---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getSiteSettings } from '../data/site-config';
import { destinations } from '../data/destinations';
import { services } from '../data/services';

const settings = getSiteSettings();
---
<SiteLayout title="About SIGNUP Visa & Migration" description="Learn about SIGNUP Visa & Migration, our approach, pathways and commitment to clear visa and migration guidance." settings={settings}>
  <section class="relative overflow-hidden bg-brand-surface py-16 sm:py-24">
    <div class="absolute -right-40 -top-40 h-[30rem] w-[30rem] rounded-full bg-brand-accent-bg blur-3xl"></div>
    <div class="relative mx-auto max-w-5xl px-5 text-center">
      <span class="rounded-full bg-brand-accent-bg px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-accent-text">About SIGNUP</span>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl">A clearer way to plan your <span class="text-gradient">journey abroad</span></h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-brand-muted sm:text-lg">{settings.about_text || 'SIGNUP Visa & Migration helps applicants explore international study, work, migration and visit visa pathways with practical guidance and organised application support.'}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl border border-brand-line bg-white p-7 shadow-sm sm:p-9">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-accent-text">Our Vision</span>
        <h2 class="mt-3 text-2xl font-extrabold">Make international opportunities easier to understand.</h2>
        <p class="mt-4 text-sm leading-7 text-brand-muted">We aim to make complex visa and migration journeys easier to navigate by presenting information clearly and helping applicants prepare thoughtfully.</p>
      </div>
      <div class="rounded-3xl border border-brand-line bg-white p-7 shadow-sm sm:p-9">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-accent-text">Our Mission</span>
        <h2 class="mt-3 text-2xl font-extrabold">Guide each applicant around their actual goals.</h2>
        <p class="mt-4 text-sm leading-7 text-brand-muted">Our approach starts with the applicant's profile, destination and objective rather than a one-size-fits-all pathway.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-brand-line bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="text-center">
        <span class="rounded-full bg-brand-accent-bg px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-accent-text">What we do</span>
        <h2 class="mt-3 text-2xl font-extrabold sm:text-3xl">One place for multiple pathways</h2>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((service) => (
          <a href={`/services/${service.slug}`} class="rounded-2xl border border-brand-line bg-brand-surface p-6 transition-all hover:-translate-y-1 hover:bg-white hover:shadow-lg">
            <span class="text-2xl" aria-hidden="true">{service.icon}</span>
            <h3 class="mt-4 font-bold">{service.name}</h3>
            <p class="mt-2 text-sm leading-6 text-brand-muted">{service.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand-accent-text">Where we help</span>
        <h2 class="mt-3 text-2xl font-extrabold sm:text-3xl">Explore our destination pathways</h2>
        <p class="mt-4 text-sm leading-7 text-brand-muted">Explore destination information first, then speak with us about the pathway that matches your circumstances.</p>
        <a href="/destinations" class="mt-6 inline-flex rounded-full bg-gradient-brand px-6 py-3 text-sm font-bold text-white">Explore Destinations →</a>
      </div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        {destinations.map((destination) => (
          <a href={`/destinations/${destination.slug}`} class="rounded-2xl border border-brand-line bg-white p-5 text-center shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg">
            <img src={destination.imageUrl} alt={destination.name} loading="lazy" class="mx-auto h-24 w-full rounded-xl object-cover" />
            <div class="mt-3 text-sm font-bold">{destination.name}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-brand-line bg-brand-surface py-16">
    <div class="mx-auto max-w-5xl px-5 text-center">
      <span class="rounded-full bg-brand-accent-bg px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-accent-text">Work with us</span>
      <h2 class="mt-4 text-2xl font-extrabold sm:text-3xl">Partnerships, media & careers</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-brand-muted">For institutional partnerships, media enquiries or career opportunities, contact the relevant SIGNUP team.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="mailto:partners@signupvisa.com" class="rounded-full border border-brand-line bg-white px-5 py-2.5 text-sm font-bold">partners@signupvisa.com</a>
        <a href="mailto:media@signupvisa.com" class="rounded-full border border-brand-line bg-white px-5 py-2.5 text-sm font-bold">media@signupvisa.com</a>
        <a href="mailto:careers@signupvisa.com" class="rounded-full border border-brand-line bg-white px-5 py-2.5 text-sm font-bold">careers@signupvisa.com</a>
      </div>
    </div>
  </section>
</SiteLayout>
