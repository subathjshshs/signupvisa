---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { destinations } from '../../data/destinations';
import { getSiteSettings } from '../../data/site-config';

const settings = getSiteSettings();
---
<SiteLayout
  title="Destinations"
  description="Explore study, work, migration and visit pathways across Australia, the UK, USA, Canada and Europe."
  settings={settings}
>
  <main>
    <section class="relative overflow-hidden border-b border-brand-line bg-brand-surface">
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_top_right,rgba(26,86,219,0.12),transparent_42%),radial-gradient(circle_at_bottom_left,rgba(124,58,237,0.10),transparent_38%)]"></div>
      <div class="relative mx-auto max-w-7xl px-5 py-20 sm:py-28">
        <div class="max-w-3xl">
          <span class="inline-flex rounded-full border border-brand-accent-text/15 bg-brand-accent-bg px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-brand-accent-text">Global destinations</span>
          <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight sm:text-6xl">Choose your <span class="text-gradient">next destination.</span></h1>
          <p class="mt-5 max-w-2xl text-base leading-7 text-brand-muted sm:text-lg">Explore international pathways for study, work, migration and visits. Start with the destination that matches your goals, then speak with our team about your options.</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 sm:py-24">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {destinations.map((destination, index) => (
          <a
            href={`/destinations/${destination.slug}`}
            class={`group relative overflow-hidden rounded-3xl border border-brand-line bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl ${index === 0 ? 'lg:col-span-2' : ''}`}
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-brand-surface">
              <img src={destination.imageUrl} alt={destination.name} loading={index > 1 ? 'lazy' : 'eager'} decoding="async" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/10 to-transparent"></div>
              <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4 text-white">
                <div>
                  <span class="text-2xl" aria-hidden="true">{destination.flag}</span>
                  <h2 class="mt-1 text-2xl font-extrabold sm:text-3xl">{destination.name}</h2>
                </div>
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white/15 text-xl backdrop-blur transition group-hover:bg-white group-hover:text-brand-blue" aria-hidden="true">→</span>
              </div>
            </div>
            <div class="p-6">
              <p class="text-sm font-semibold text-brand-ink">{destination.summary}</p>
              <p class="mt-2 text-sm leading-6 text-brand-muted">{destination.description}</p>
              <span class="mt-5 inline-flex items-center text-sm font-bold text-brand-blue">Explore pathway <span class="ml-1 transition-transform group-hover:translate-x-1">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="px-5 pb-16 sm:pb-24">
      <div class="mx-auto max-w-5xl overflow-hidden rounded-3xl bg-gradient-brand px-7 py-12 text-center text-white sm:px-12 sm:py-14">
        <span class="text-xs font-bold uppercase tracking-wider text-white/70">Not sure where to begin?</span>
        <h2 class="mt-3 text-2xl font-extrabold sm:text-3xl">Let’s find the right pathway for you.</h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-white/80">Tell us your goals and we’ll help you understand the available destination and visa options.</p>
        <a href="/contact" class="mt-7 inline-flex rounded-full bg-white px-7 py-3 text-sm font-bold text-brand-blue transition hover:-translate-y-0.5">Book a Consultation →</a>
      </div>
    </section>
  </main>
</SiteLayout>
