---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { destinations } from '../../data/destinations';
import { getSiteSettings } from '../../data/site-config';

const settings = getSiteSettings();
const [featuredDestination, ...otherDestinations] = destinations;

const pathwayCards = [
  { icon: '🎓', title: 'Study abroad', text: 'Explore education destinations and plan the application journey around your academic goals.' },
  { icon: '💼', title: 'Work abroad', text: 'Understand work permit routes, requirements and practical application steps.' },
  { icon: '🌍', title: 'Skilled migration', text: 'Explore migration pathways based on your skills, experience and destination.' },
  { icon: '✈️', title: 'Visit overseas', text: 'Prepare an eligible short-stay application with clear documentation guidance.' },
];
---

<SiteLayout
  title="Destinations"
  description="Explore study, work, skilled migration and visit pathways across Australia, the UK, USA, Canada and Europe with SIGNUP Visa & Migration."
  settings={settings}
>
  <main>
    <section class="relative overflow-hidden bg-brand-ink text-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_15%,rgba(124,58,237,.28),transparent_34%),radial-gradient(circle_at_10%_90%,rgba(26,86,219,.24),transparent_38%)]"></div>
      <div class="relative mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28 lg:px-10">
        <div class="max-w-4xl">
          <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-[.18em] text-white/55">
            <span>Global destinations</span><span class="h-px w-8 bg-white/20"></span><span>Study · Work · Visit · Migration</span>
          </div>
          <h1 class="mt-6 max-w-4xl text-4xl font-extrabold leading-[1.04] tracking-[-.035em] sm:text-6xl lg:text-7xl">Find the destination that fits <span class="text-white/55">your next move.</span></h1>
          <p class="mt-6 max-w-2xl text-base leading-7 text-white/70 sm:text-lg sm:leading-8">Compare the destinations we currently feature, understand the pathways available, and start with the route that matches your goals.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/contact" class="inline-flex items-center justify-center rounded-full bg-white px-7 py-3.5 text-sm font-bold text-brand-ink transition hover:-translate-y-0.5 hover:bg-white/90">Discuss my options <span class="ml-2">→</span></a>
            <a href="/services" class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/5 px-7 py-3.5 text-sm font-bold text-white transition hover:bg-white/10">Explore services</a>
          </div>
        </div>
      </div>
      <div class="relative border-t border-white/10 bg-white/[.04]">
        <div class="mx-auto grid max-w-7xl grid-cols-2 sm:grid-cols-5">
          {destinations.map((destination, index) => (
            <a href={`/destinations/${destination.slug}`} class={`group flex items-center gap-3 border-white/10 px-5 py-5 transition hover:bg-white/[.06] sm:px-6 ${index < destinations.length - 1 ? 'sm:border-r' : ''}`}>
              <span class="text-xl" aria-hidden="true">{destination.flag}</span>
              <span class="text-sm font-bold text-white/80 group-hover:text-white">{destination.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-brand-line bg-white">
      <div class="mx-auto grid max-w-7xl gap-6 px-5 py-10 sm:grid-cols-2 sm:px-8 sm:py-12 lg:grid-cols-4 lg:px-10">
        {pathwayCards.map((item) => (
          <article class="flex gap-4 rounded-2xl bg-brand-surface p-5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-white text-xl shadow-sm" aria-hidden="true">{item.icon}</span>
            <div><h2 class="text-sm font-extrabold">{item.title}</h2><p class="mt-1.5 text-xs leading-5 text-brand-muted">{item.text}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-10">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-brand-accent-text">Explore destinations</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Start with a country. Build the pathway from there.</h2>
        <p class="mt-4 text-sm leading-7 text-brand-muted sm:text-base">Each destination page gives you a simple overview of the study, work, migration and visit routes we can help you explore.</p>
      </div>

      {featuredDestination && (
        <a href={`/destinations/${featuredDestination.slug}`} class="group mt-10 grid overflow-hidden rounded-[2rem] bg-brand-ink text-white shadow-sm lg:grid-cols-[1.15fr_.85fr]">
          <div class="relative min-h-[330px] overflow-hidden sm:min-h-[420px]">
            <img src={featuredDestination.imageUrl} alt={`${featuredDestination.name} destination`} class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="eager" decoding="async" />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-ink/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-6 left-6 flex items-center gap-3 sm:bottom-8 sm:left-8"><span class="text-3xl" aria-hidden="true">{featuredDestination.flag}</span><span class="text-sm font-bold text-white/75">Featured destination</span></div>
          </div>
          <div class="flex flex-col justify-center p-7 sm:p-10 lg:p-12">
            <span class="text-xs font-bold uppercase tracking-[.18em] text-white/45">{featuredDestination.flag} Featured pathway</span>
            <h3 class="mt-3 text-3xl font-extrabold sm:text-4xl">{featuredDestination.name}</h3>
            <p class="mt-4 text-sm leading-7 text-white/65">{featuredDestination.description}</p>
            <span class="mt-7 inline-flex items-center text-sm font-bold">Explore {featuredDestination.name} <span class="ml-2 transition-transform group-hover:translate-x-1">→</span></span>
          </div>
        </a>
      )}

      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {otherDestinations.map((destination) => (
          <a href={`/destinations/${destination.slug}`} class="group overflow-hidden rounded-3xl border border-brand-line bg-white transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="relative aspect-[16/10] overflow-hidden bg-brand-surface">
              <img src={destination.imageUrl} alt={`${destination.name} destination`} class="h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 flex items-center gap-2 text-white"><span class="text-xl" aria-hidden="true">{destination.flag}</span><h3 class="text-lg font-extrabold">{destination.name}</h3></div>
            </div>
            <div class="p-5"><p class="text-sm font-semibold text-brand-ink">{destination.summary}</p><span class="mt-4 inline-flex items-center text-xs font-bold uppercase tracking-wider text-brand-blue">Explore pathway <span class="ml-1 transition-transform group-hover:translate-x-1">→</span></span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="px-5 pb-20 sm:px-8 sm:pb-24 lg:px-10">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-brand-surface p-8 sm:p-12 lg:flex lg:items-center lg:justify-between lg:gap-12">
        <div><p class="text-xs font-bold uppercase tracking-[.18em] text-brand-accent-text">Need help choosing?</p><h2 class="mt-3 text-2xl font-extrabold tracking-tight sm:text-3xl">Your best destination depends on your goal.</h2><p class="mt-3 max-w-2xl text-sm leading-6 text-brand-muted">Share what you want to study, where you want to work, or why you want to travel. We can help you understand the relevant options before you take the next step.</p></div>
        <a href="/contact" class="mt-7 inline-flex shrink-0 rounded-full bg-brand-ink px-7 py-3.5 text-sm font-bold text-white transition hover:-translate-y-0.5 lg:mt-0">Start a consultation →</a>
      </div>
    </section>
  </main>
</SiteLayout>
