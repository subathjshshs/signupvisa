---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';
import ImageUploadField from '../../components/ImageUploadField.astro';
import { env } from 'cloudflare:workers';

const db = (env as any).DB;
const editId = Astro.url.searchParams.get('edit');
let editing: any = null;
let services: any[] = [];
if (db) {
  try {
    if (editId) editing = await db.prepare('SELECT * FROM services WHERE id=?').bind(editId).first();
    const r = await db.prepare('SELECT * FROM services ORDER BY sort_order ASC').all();
    services = r.results as any[];
  } catch(e) {}
}
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Manage Services</title></head>
<body class="admin-shell">
  <AdminNav active="services" />
  <div class="admin-body">
    <h1 style="font-family:var(--font-display); margin-bottom:6px;">Services</h1>
    <p style="color:var(--text-muted); margin-bottom:24px;">Start with Student Visa. Add Work Visa, Skilled Migration, Visit Visa later — each becomes a live page automatically.</p>

    {services.length > 0 && (
      <table class="admin-table" style="margin-bottom:32px;">
        <thead><tr><th>Service</th><th>Slug</th><th>Featured</th><th>Active</th><th></th></tr></thead>
        <tbody>
          {services.map((s: any) => (
            <tr>
              <td>{s.name}</td>
              <td style="color:var(--text-muted); font-size:0.85rem;">/services/{s.slug}</td>
              <td>{s.is_featured ? '⭐ Yes' : '—'}</td>
              <td>{s.is_active ? '✅' : '❌'}</td>
              <td>
                <a href={`/admin/services?edit=${s.id}`} style="margin-right:10px;">Edit</a>
                <button class="delete-btn" data-id={s.id} style="background:none;border:none;color:#9B3B2E;cursor:pointer;padding:0;">Delete</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <div class="card" style="max-width:660px;">
      <h2 style="font-family:var(--font-display); font-size:1.15rem; margin-bottom:20px;">
        {editing ? `Editing: ${editing.name}` : '+ Add new service'}
      </h2>
      <div id="form-success" style="display:none; background:#E6F0EA; color:#2F6D4F; padding:12px; border-radius:3px; margin-bottom:16px;">✓ Saved!</div>
      <div id="form-error" style="display:none; background:#FBE9E7; color:#9B3B2E; padding:12px; border-radius:3px; margin-bottom:16px;">Error — check the slug is unique.</div>

      <form id="service-form" data-id={editing ? editing.id : ''}>
        <div class="form-field">
          <label>Service name *</label>
          <input type="text" name="name" value={editing ? editing.name : ''} required placeholder="e.g. Student Visa Processing" />
        </div>
        <div class="form-field">
          <label>URL slug * {editing ? '(cannot change)' : '— lowercase, no spaces (e.g. student-visa)'}</label>
          <input type="text" name="slug" value={editing ? editing.slug : ''} disabled={!!editing} required placeholder="student-visa" />
        </div>
        <div class="form-field">
          <label>Short tagline (shown on cards)</label>
          <input type="text" name="tagline" value={editing ? editing.tagline : ''} placeholder="End-to-end student visa support" />
        </div>
        <div class="form-field">
          <label>Full description</label>
          <textarea name="description" rows="5" placeholder="Describe this service in detail...">{editing ? editing.description : ''}</textarea>
        </div>
        <ImageUploadField name="image_url" label="Service image" value={editing ? editing.image_url : ''} />
        <div class="form-field">
          <label><input type="checkbox" name="is_featured" style="width:auto;display:inline-block;margin-right:8px;" checked={editing ? !!editing.is_featured : true} /> Feature on homepage</label>
        </div>
        <div class="form-field">
          <label><input type="checkbox" name="is_active" style="width:auto;display:inline-block;margin-right:8px;" checked={editing ? !!editing.is_active : true} /> Active (visible on site)</label>
        </div>
        <div style="display:flex;gap:12px;align-items:center;margin-top:8px;">
          <button type="submit" class="btn btn-primary">{editing ? 'Save Changes' : 'Add Service'}</button>
          {editing && <a href="/admin/services">Cancel</a>}
        </div>
      </form>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this service?')) return;
        await fetch(`/api/admin/services/${btn.dataset.id}`, { method: 'DELETE' });
        window.location.reload();
      });
    });

    const form = document.getElementById('service-form') as HTMLFormElement;
    const success = document.getElementById('form-success') as HTMLElement;
    const error = document.getElementById('form-error') as HTMLElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      success.style.display = 'none'; error.style.display = 'none';
      const id = form.dataset.id;
      const fd = new FormData(form);
      const body: any = Object.fromEntries(fd.entries());
      body.is_featured = fd.has('is_featured');
      body.is_active = fd.has('is_active');
      const res = await fetch(id ? `/api/admin/services/${id}` : '/api/admin/services', {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (res.ok) {
        if (id) { success.style.display = 'block'; window.scrollTo({top:0,behavior:'smooth'}); }
        else window.location.href = '/admin/services';
      } else { error.style.display = 'block'; }
    });
  </script>
</body>
</html>
