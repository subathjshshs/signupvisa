---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';
import { env } from 'cloudflare:workers';

const db = (env as any).DB;
let services: any[] = [];

if (db) {
  try {
    const res = await db.prepare('SELECT * FROM services ORDER BY created_at DESC').all();
    services = res.results || [];
  } catch (err) {
    console.error('Failed to fetch services:', err);
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Manage Services</title>
</head>
<body class="admin-shell">
  <AdminNav active="services" />
  <div class="admin-body">
    <h1>Services</h1>
    {!db && (
      <p style="color: red;">⚠️ D1 Database binding "DB" is missing in Cloudflare environment.</p>
    )}
    <!-- Rest of your Services UI template -->
  </div>
</body>
</html>
