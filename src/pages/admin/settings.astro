---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';
import { env } from 'cloudflare:workers';

// Safely grab the database from Cloudflare
const db = (env as any)?.DB || (Astro.locals as any)?.runtime?.env?.DB;
let services: any[] = [];

// Only run query if database is ready
if (db) {
  try {
    const res = await db.prepare('SELECT * FROM services ORDER BY created_at DESC').all();
    services = res.results || [];
  } catch (err) {
    console.error('Database query error:', err);
  }
}
---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';
import { env } from 'cloudflare:workers';

const db = (env as any).DB;
let settings: any = {};

if (db) {
  try {
    const res = await db.prepare('SELECT * FROM settings').all();
    const rows = res.results || [];
    settings = rows.reduce((acc: any, row: any) => {
      acc[row.key] = row.value;
      return acc;
    }, {});
  } catch (err) {
    console.error('Failed to fetch settings:', err);
  }
}
