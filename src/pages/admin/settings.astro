---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';
import { env } from 'cloudflare:workers';

const db = (env as any)?.DB || (Astro.locals as any)?.runtime?.env?.DB;

let settings: any = {};

if (db) {
  try {
    const res = await db.prepare('SELECT * FROM settings').all();
    const rows = res.results || [];
    settings = rows.reduce((acc: any, row: any) => {
      acc[row.key] = row.value;
      return acc;
    }, {});
  } catch (err) {
    console.error('Failed to fetch settings:', err);
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Settings</title>
</head>
<body class="admin-shell">
  <AdminNav active="settings" />
  <main class="admin-body">
    <h1>Settings</h1>
    {!db && (
      <p style="color: red; font-weight: bold;">⚠️ D1 Database binding "DB" is not connected.</p>
    )}
    <pre>{JSON.stringify(settings, null, 2)}</pre>
  </main>
</body>
</html>
