---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';

// Safely retrieve D1 binding across Astro 5 & Cloudflare Page versions
const runtime = (Astro.locals as any)?.runtime || {};
const db = runtime.env?.DB || runtime.DB;

let servicesCount = 0;
let destCount = 0;
let leadsCount = 0;
let newLeadsCount = 0;

if (db) {
  try {
    const [s, d, l, nl] = await Promise.all([
      db.prepare('SELECT COUNT(*) as c FROM services').first(),
      db.prepare('SELECT COUNT(*) as c FROM destinations').first(),
      db.prepare('SELECT COUNT(*) as c FROM leads').first(),
      db.prepare("SELECT COUNT(*) as c FROM leads WHERE status='new'").first(),
    ]);

    servicesCount = (s as any)?.c ?? 0;
    destCount = (d as any)?.c ?? 0;
    leadsCount = (l as any)?.c ?? 0;
    newLeadsCount = (nl as any)?.c ?? 0;
  } catch (err) {
    console.error('Database query error:', err);
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard</title>
</head>
<body class="admin-shell">
  <AdminNav active="" />
  <div class="admin-body">
    <h1 style="font-family:var(--font-display); margin-bottom:24px;">Dashboard</h1>
    
    {!db && (
      <div style="background:#fee2e2; color:#991b1b; padding:12px 16px; border-radius:6px; margin-bottom:24px;">
        ⚠️ <strong>Warning:</strong> D1 Database binding "DB" was not detected in Cloudflare.
      </div>
    )}

    <div class="grid-3">
      <div class="card"><span class="eyebrow">Services</span><h2>{servicesCount}</h2></div>
      <div class="card"><span class="eyebrow">Destinations</span><h2>{destCount}</h2></div>
      <div class="card"><span class="eyebrow">New Leads</span><h2>{newLeadsCount} <span style="font-size:1rem; color:var(--text-muted);">/ {leadsCount} total</span></h2></div>
    </div>
    <p style="margin-top:32px; color:var(--text-muted);">Use the nav above to manage services, destinations, testimonials, blog posts, leads, and site-wide settings.</p>
  </div>
</body>
</html>
