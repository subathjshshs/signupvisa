---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';
import ImageUploadField from '../../components/ImageUploadField.astro';

const db = Astro.locals.runtime?.DB;
const editId = Astro.url.searchParams.get('edit');
const editing = editId ? await db.prepare('SELECT * FROM destinations WHERE id=?').bind(editId).first() : null;
const { results: destinations } = await db.prepare('SELECT * FROM destinations ORDER BY sort_order ASC').all();
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Manage Destinations</title></head>
<body class="admin-shell">
  <AdminNav active="destinations" />
  <div class="admin-body">
    <h1 style="font-family:var(--font-display);">Destinations</h1>
    <p style="color:var(--text-muted); margin-bottom:24px;">Countries you place students in today, and any new markets you expand into later.</p>

    <table class="admin-table" style="margin-bottom:32px;">
      <thead><tr><th>Country</th><th>Slug</th><th>Active</th><th>Featured</th><th></th></tr></thead>
      <tbody>
        {destinations.map((d: any) => (
          <tr>
            <td>{d.flag_emoji} {d.country_name}</td>
            <td>/destinations/{d.slug}</td>
            <td>{d.is_active ? 'Yes' : 'Hidden'}</td>
            <td>{d.is_featured ? 'Yes' : '—'}</td>
            <td>
              <a href={`/admin/destinations?edit=${d.id}`}>Edit</a> ·
              <button class="delete-btn" data-id={d.id} style="background:none; border:none; color:#9B3B2E; cursor:pointer; padding:0;">Delete</button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 style="font-family:var(--font-display); font-size:1.2rem;">{editing ? `Edit: ${(editing as any).country_name}` : 'Add new destination'}</h2>
    <form id="dest-form" class="card" data-id={editing ? (editing as any).id : ''} style="max-width:640px;">
      <div class="form-field">
        <label for="country_name">Country name</label>
        <input type="text" id="country_name" name="country_name" value={editing ? (editing as any).country_name : ''} required />
      </div>
      <div class="form-field">
        <label for="slug">URL slug (e.g. australia) {editing && '— cannot be changed once created'}</label>
        <input type="text" id="slug" name="slug" value={editing ? (editing as any).slug : ''} disabled={!!editing} required />
      </div>
      <div class="form-field">
        <label for="flag_emoji">Flag emoji (optional, e.g. 🇦🇺)</label>
        <input type="text" id="flag_emoji" name="flag_emoji" value={editing ? (editing as any).flag_emoji : ''} />
      </div>
      <div class="form-field">
        <label for="summary">Short summary</label>
        <input type="text" id="summary" name="summary" value={editing ? (editing as any).summary : ''} />
      </div>
      <div class="form-field">
        <label for="description">Full description</label>
        <textarea id="description" name="description" rows="5">{editing ? (editing as any).description : ''}</textarea>
      </div>
      <ImageUploadField name="image_url" label="Destination image" value={editing ? (editing as any).image_url : ''} />
      <div class="form-field">
        <label><input type="checkbox" name="is_featured" checked={editing ? !!(editing as any).is_featured : false} style="width:auto; display:inline-block; margin-right:8px;" /> Feature on homepage</label>
      </div>
      <div class="form-field">
        <label><input type="checkbox" name="is_active" checked={editing ? !!(editing as any).is_active : true} style="width:auto; display:inline-block; margin-right:8px;" /> Active (visible on site)</label>
      </div>
      <button type="submit" class="btn btn-primary">{editing ? 'Save Changes' : 'Add Destination'}</button>
      {editing && <a href="/admin/destinations" style="margin-left:12px; font-size:0.9rem;">Cancel edit</a>}
      <p class="form-status"></p>
    </form>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this destination?')) return;
        await fetch(`/api/admin/destinations/${btn.dataset.id}`, { method: 'DELETE' });
        window.location.reload();
      });
    });

    const form = document.getElementById('dest-form') as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = form.dataset.id;
      const fd = new FormData(form);
      const body: Record<string, any> = Object.fromEntries(fd.entries());
      body.is_featured = fd.has('is_featured');
      body.is_active = fd.has('is_active');
      const status = form.querySelector('.form-status') as HTMLElement;
      status.textContent = 'Saving...';
      const res = await fetch(id ? `/api/admin/destinations/${id}` : '/api/admin/destinations', {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (res.ok) {
        window.location.href = '/admin/destinations';
      } else {
        status.textContent = 'Something went wrong — check the slug is unique.';
      }
    });
  </script>
</body>
</html>
