---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';
import ImageUploadField from '../../components/ImageUploadField.astro';

const db = Astro.locals.runtime?.env?.DB;
const editId = Astro.url.searchParams.get('edit');
let editing: any = null;
let destinations: any[] = [];
if (db) {
  try {
    if (editId) editing = await db.prepare('SELECT * FROM destinations WHERE id=?').bind(editId).first();
    const r = await db.prepare('SELECT * FROM destinations ORDER BY sort_order ASC').all();
    destinations = r.results as any[];
  } catch(e) {}
}
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Manage Destinations</title></head>
<body class="admin-shell">
  <AdminNav active="destinations" />
  <div class="admin-body">
    <h1 style="font-family:var(--font-display); margin-bottom:6px;">Destinations</h1>
    <p style="color:var(--text-muted); margin-bottom:24px;">Add countries here — each gets its own page automatically. Add more countries anytime.</p>

    {destinations.length > 0 && (
      <table class="admin-table" style="margin-bottom:32px;">
        <thead><tr><th>Country</th><th>Slug</th><th>Featured</th><th>Active</th><th></th></tr></thead>
        <tbody>
          {destinations.map((d: any) => (
            <tr>
              <td>{d.flag_emoji} {d.country_name}</td>
              <td style="color:var(--text-muted); font-size:0.85rem;">/destinations/{d.slug}</td>
              <td>{d.is_featured ? '⭐ Yes' : '—'}</td>
              <td>{d.is_active ? '✅' : '❌'}</td>
              <td>
                <a href={`/admin/destinations?edit=${d.id}`} style="margin-right:10px;">Edit</a>
                <button class="delete-btn" data-id={d.id} style="background:none;border:none;color:#9B3B2E;cursor:pointer;padding:0;">Delete</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <div class="card" style="max-width:660px;">
      <h2 style="font-family:var(--font-display); font-size:1.15rem; margin-bottom:20px;">
        {editing ? `Editing: ${editing.country_name}` : '+ Add new destination'}
      </h2>
      <div id="form-success" style="display:none; background:#E6F0EA; color:#2F6D4F; padding:12px; border-radius:3px; margin-bottom:16px;">✓ Saved successfully!</div>
      <div id="form-error" style="display:none; background:#FBE9E7; color:#9B3B2E; padding:12px; border-radius:3px; margin-bottom:16px;">Something went wrong. Check that the slug is unique.</div>

      <form id="dest-form" data-id={editing ? editing.id : ''}>
        <div class="form-field">
          <label>Country name *</label>
          <input type="text" name="country_name" value={editing ? editing.country_name : ''} required placeholder="e.g. Australia" />
        </div>
        <div class="form-field">
          <label>URL slug * {editing ? '(cannot change)' : '— use lowercase, no spaces (e.g. australia)'}</label>
          <input type="text" name="slug" value={editing ? editing.slug : ''} disabled={!!editing} required placeholder="australia" />
        </div>
        <div class="form-field">
          <label>Flag emoji (optional)</label>
          <input type="text" name="flag_emoji" value={editing ? editing.flag_emoji : ''} placeholder="🇦🇺" />
        </div>
        <div class="form-field">
          <label>Short summary (shown on cards)</label>
          <input type="text" name="summary" value={editing ? editing.summary : ''} placeholder="Top universities, post-study work rights" />
        </div>
        <div class="form-field">
          <label>Full description (shown on the country's page)</label>
          <textarea name="description" rows="5" placeholder="Write about studying in this country...">{editing ? editing.description : ''}</textarea>
        </div>
        <ImageUploadField name="image_url" label="Country image" value={editing ? editing.image_url : ''} />
        <div class="form-field">
          <label><input type="checkbox" name="is_featured" style="width:auto;display:inline-block;margin-right:8px;" checked={editing ? !!editing.is_featured : false} /> Show on homepage</label>
        </div>
        <div class="form-field">
          <label><input type="checkbox" name="is_active" style="width:auto;display:inline-block;margin-right:8px;" checked={editing ? !!editing.is_active : true} /> Active (visible on site)</label>
        </div>
        <div style="display:flex;gap:12px;align-items:center;margin-top:8px;">
          <button type="submit" class="btn btn-primary">{editing ? 'Save Changes' : 'Add Destination'}</button>
          {editing && <a href="/admin/destinations">Cancel</a>}
        </div>
      </form>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this destination? This cannot be undone.')) return;
        await fetch(`/api/admin/destinations/${btn.dataset.id}`, { method: 'DELETE' });
        window.location.reload();
      });
    });

    const form = document.getElementById('dest-form') as HTMLFormElement;
    const success = document.getElementById('form-success') as HTMLElement;
    const error = document.getElementById('form-error') as HTMLElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      success.style.display = 'none'; error.style.display = 'none';
      const id = form.dataset.id;
      const fd = new FormData(form);
      const body: any = Object.fromEntries(fd.entries());
      body.is_featured = fd.has('is_featured');
      body.is_active = fd.has('is_active');
      const res = await fetch(id ? `/api/admin/destinations/${id}` : '/api/admin/destinations', {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (res.ok) {
        if (id) { success.style.display = 'block'; window.scrollTo({top:0,behavior:'smooth'}); }
        else window.location.href = '/admin/destinations';
      } else { error.style.display = 'block'; }
    });
  </script>
</body>
</html>
