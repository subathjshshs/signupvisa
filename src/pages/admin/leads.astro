---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';

const db = Astro.locals.runtime.env.DB;
const { results: leads } = await db.prepare('SELECT * FROM leads ORDER BY created_at DESC').all();
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Leads</title></head>
<body class="admin-shell">
  <AdminNav active="leads" />
  <div class="admin-body">
    <h1 style="font-family:var(--font-display);">Leads</h1>
    <p style="color:var(--text-muted); margin-bottom:24px;">Everyone who submitted the "Book a Consultation" form.</p>

    <table class="admin-table">
      <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>Interested In</th><th>Message</th><th>Status</th><th>When</th><th></th></tr></thead>
      <tbody>
        {leads.map((l: any) => (
          <tr>
            <td>{l.full_name}</td>
            <td>{l.phone}</td>
            <td>{l.email}</td>
            <td>{l.interested_service}</td>
            <td style="max-width:220px;">{l.message}</td>
            <td>
              <select class="status-select" data-id={l.id}>
                <option value="new" selected={l.status === 'new'}>New</option>
                <option value="contacted" selected={l.status === 'contacted'}>Contacted</option>
                <option value="converted" selected={l.status === 'converted'}>Converted</option>
                <option value="closed" selected={l.status === 'closed'}>Closed</option>
              </select>
            </td>
            <td style="font-size:0.8rem; color:var(--text-muted);">{l.created_at}</td>
            <td><button class="delete-btn" data-id={l.id} style="background:none; border:none; color:#9B3B2E; cursor:pointer; padding:0;">Delete</button></td>
          </tr>
        ))}
        {leads.length === 0 && <tr><td colspan="8">No leads yet.</td></tr>}
      </tbody>
    </table>
  </div>

  <script>
    document.querySelectorAll<HTMLSelectElement>('.status-select').forEach((sel) => {
      sel.addEventListener('change', async () => {
        await fetch(`/api/admin/leads/${sel.dataset.id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: sel.value }),
        });
      });
    });
    document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this lead?')) return;
        await fetch(`/api/admin/leads/${btn.dataset.id}`, { method: 'DELETE' });
        window.location.reload();
      });
    });
  </script>
</body>
</html>
