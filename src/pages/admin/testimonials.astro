---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';
import ImageUploadField from '../../components/ImageUploadField.astro';

const db = Astro.locals.runtime?.env?.DB;
let testimonials: any[] = [];
if (db) {
  try {
    const r = await db.prepare('SELECT * FROM testimonials ORDER BY sort_order ASC').all();
    testimonials = r.results as any[];
  } catch(e) {}
}
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Testimonials</title></head>
<body class="admin-shell">
  <AdminNav active="testimonials" />
  <div class="admin-body">
    <h1 style="font-family:var(--font-display); margin-bottom:6px;">Testimonials</h1>
    <p style="color:var(--text-muted); margin-bottom:24px;">Real student success stories shown on the homepage and Success Stories page.</p>

    {testimonials.length > 0 && (
      <table class="admin-table" style="margin-bottom:32px;">
        <thead><tr><th>Student</th><th>Destination</th><th>Quote</th><th></th></tr></thead>
        <tbody>
          {testimonials.map((t: any) => (
            <tr>
              <td>{t.student_name}</td>
              <td>{t.destination}</td>
              <td style="max-width:260px; font-size:0.85rem;">{String(t.quote).slice(0, 80)}...</td>
              <td><button class="delete-btn" data-id={t.id} style="background:none;border:none;color:#9B3B2E;cursor:pointer;padding:0;">Delete</button></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <div class="card" style="max-width:660px;">
      <h2 style="font-family:var(--font-display); font-size:1.15rem; margin-bottom:20px;">+ Add testimonial</h2>
      <div id="form-success" style="display:none; background:#E6F0EA; color:#2F6D4F; padding:12px; border-radius:3px; margin-bottom:16px;">✓ Testimonial added!</div>
      <div id="form-error" style="display:none; background:#FBE9E7; color:#9B3B2E; padding:12px; border-radius:3px; margin-bottom:16px;">Something went wrong.</div>

      <form id="testimonial-form">
        <div class="form-field">
          <label>Student full name *</label>
          <input type="text" name="student_name" required placeholder="e.g. Rahul Ahmed" />
        </div>
        <div class="form-field">
          <label>Destination / achievement</label>
          <input type="text" name="destination" placeholder="e.g. Now studying in Australia" />
        </div>
        <div class="form-field">
          <label>Quote * (what they said about your service)</label>
          <textarea name="quote" rows="4" required placeholder="Their testimonial in their own words..."></textarea>
        </div>
        <ImageUploadField name="photo_url" label="Student photo (optional)" value="" />
        <button type="submit" class="btn btn-primary" style="margin-top:8px;">Add Testimonial</button>
      </form>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this testimonial?')) return;
        await fetch(`/api/admin/testimonials/${btn.dataset.id}`, { method: 'DELETE' });
        window.location.reload();
      });
    });

    const form = document.getElementById('testimonial-form') as HTMLFormElement;
    const success = document.getElementById('form-success') as HTMLElement;
    const error = document.getElementById('form-error') as HTMLElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      success.style.display = 'none'; error.style.display = 'none';
      const fd = new FormData(form);
      const body = Object.fromEntries(fd.entries());
      const res = await fetch('/api/admin/testimonials', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (res.ok) { form.reset(); success.style.display = 'block'; window.scrollTo({top:0,behavior:'smooth'}); }
      else error.style.display = 'block';
    });
  </script>
</body>
</html>
