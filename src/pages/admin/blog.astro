---
import '../../styles/global.css';
import AdminNav from '../../components/AdminNav.astro';
import { env } from 'cloudflare:workers';

const db = (env as any)?.DB || (Astro.locals as any)?.runtime?.env?.DB;

let posts: any[] = [];

if (db) {
  try {
    const res = await db.prepare('SELECT * FROM posts ORDER BY created_at DESC').all();
    posts = res.results || [];
  } catch (err) {
    console.error('Failed to fetch blog posts:', err);
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manage Blog Posts</title>
</head>
<body class="admin-shell">
  <AdminNav active="blog" />
  <main class="admin-body">
    <h1>Blog Posts</h1>
    {!db && (
      <p style="color: red; font-weight: bold;">⚠️ D1 Database binding "DB" is not connected.</p>
    )}
    <ul>
      {posts.map((item) => (
        <li>{item.title || JSON.stringify(item)}</li>
      ))}
    </ul>
  </main>
</body>
</html>
