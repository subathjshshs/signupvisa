---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getSettings } from '../lib/content';
import { OFFICE_MOULVIBAZAR } from '../lib/images';
import { env } from 'cloudflare:workers';

const db = (env as any).DB;
const settings = db ? await getSettings(db) : {};
---
<SiteLayout title="Book a Consultation" settings={settings}>
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="text-center">
      <span class="rounded-full bg-brand-accent-bg px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-accent-text">Get in touch</span>
      <h1 class="mt-3 text-3xl font-extrabold sm:text-4xl">Book a free consultation</h1>
      <p class="mx-auto mt-3 max-w-lg text-sm text-brand-muted">Tell us a bit about your plans and we'll get back to you within one business day.</p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[1fr_1.2fr]">
      <!-- LEFT: office + contact -->
      <div class="space-y-5">
        <div class="group overflow-hidden rounded-2xl border border-brand-line bg-white shadow-sm transition-shadow hover:shadow-lg">
          <div class="h-44 overflow-hidden">
            <img src={OFFICE_MOULVIBAZAR} alt="Moulvibazar office" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" onerror="this.parentElement.style.display='none'" />
          </div>
          <div class="p-5">
            <h3 class="text-sm font-bold">Moulvibazar Regional Desk</h3>
            <p class="mt-1 text-sm text-brand-muted">{settings.address || 'Moulvibazar, Sylhet Division, Bangladesh'}</p>
            <a href={`mailto:${settings.email_moulvibazar || 'moulvibazar@signupvisa.com'}`} class="mt-2 inline-block text-sm font-semibold text-brand-accent-text">{settings.email_moulvibazar || 'moulvibazar@signupvisa.com'}</a>
          </div>
        </div>

        <div class="rounded-2xl border border-brand-line bg-white p-5">
          <h3 class="text-sm font-bold">General Contact</h3>
          <div class="mt-3 space-y-2 text-sm">
            <div class="flex justify-between"><span class="text-brand-muted">Support</span><a href={`mailto:${settings.email_support || 'support@signupvisa.com'}`} class="font-semibold text-brand-accent-text">{settings.email_support || 'support@signupvisa.com'}</a></div>
            <div class="flex justify-between"><span class="text-brand-muted">General Info</span><a href={`mailto:${settings.email_info || 'info@signupvisa.com'}`} class="font-semibold text-brand-accent-text">{settings.email_info || 'info@signupvisa.com'}</a></div>
            {settings.phone && <div class="flex justify-between"><span class="text-brand-muted">Phone</span><span class="font-semibold">{settings.phone}</span></div>}
            {settings.whatsapp && <div class="flex justify-between"><span class="text-brand-muted">WhatsApp</span><span class="font-semibold">{settings.whatsapp}</span></div>}
          </div>
        </div>
      </div>

      <!-- RIGHT: form -->
      <form id="lead-form" class="rounded-2xl border border-brand-line bg-white p-7 shadow-sm">
        <div class="space-y-4">
          <div>
            <label class="mb-1.5 block text-sm font-semibold">Full name</label>
            <input type="text" id="full_name" name="full_name" required class="w-full rounded-lg border border-brand-line px-3.5 py-2.5 text-sm outline-none focus:border-brand-blue" />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-semibold">Phone / WhatsApp</label>
            <input type="tel" id="phone" name="phone" required class="w-full rounded-lg border border-brand-line px-3.5 py-2.5 text-sm outline-none focus:border-brand-blue" />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-semibold">Email (optional)</label>
            <input type="email" id="email" name="email" class="w-full rounded-lg border border-brand-line px-3.5 py-2.5 text-sm outline-none focus:border-brand-blue" />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-semibold">I'm interested in</label>
            <select id="interested_service" name="interested_service" class="w-full rounded-lg border border-brand-line px-3.5 py-2.5 text-sm outline-none focus:border-brand-blue">
              <option>Student Visa</option>
              <option>Work Visa</option>
              <option>Skilled Migration</option>
              <option>Visit Visa</option>
              <option>Not sure yet</option>
            </select>
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-semibold">Message (optional)</label>
            <textarea id="message" name="message" rows="4" class="w-full rounded-lg border border-brand-line px-3.5 py-2.5 text-sm outline-none focus:border-brand-blue"></textarea>
          </div>
          <button type="submit" class="w-full rounded-full bg-gradient-brand py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5">Send Request</button>
          <p id="form-status" class="text-sm"></p>
        </div>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById('lead-form') as HTMLFormElement;
    const status = document.getElementById('form-status') as HTMLParagraphElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = 'Sending...';
      status.className = 'text-sm text-brand-muted';
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error();
        status.textContent = "Thanks — we've received your request and will contact you soon.";
        status.className = 'text-sm text-brand-success-text font-semibold';
        form.reset();
      } catch {
        status.textContent = 'Something went wrong. Please try again or email us directly.';
        status.className = 'text-sm text-red-600 font-semibold';
      }
    });
  </script>
</SiteLayout>
