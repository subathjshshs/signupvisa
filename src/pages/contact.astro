---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getSiteSettings } from '../data/site-config';
import { services } from '../data/services';
import { destinations } from '../data/destinations';

const settings = getSiteSettings();
---
<SiteLayout title="Contact SIGNUP Visa & Migration" description="Contact SIGNUP Visa & Migration for student visa, work permit, skilled migration and visit visa guidance." settings={settings}>
  <section class="relative overflow-hidden bg-brand-ink text-white">
    <div class="absolute -left-40 -top-40 h-[30rem] w-[30rem] rounded-full bg-brand-blue/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-10 sm:py-12">
      <span class="inline-flex rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-bold uppercase tracking-[.16em] text-white/80">Get in touch</span>
      <h1 class="mt-4 max-w-4xl text-3xl font-black tracking-tight sm:text-5xl">Let's make your <span class="text-gradient">next step clearer.</span></h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-white/70 sm:text-base sm:leading-7">Tell us what you want to achieve, where you want to go and which pathway you are considering. We'll use your enquiry to understand what you need next.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-8 sm:py-10">
    <div class="grid gap-6 lg:grid-cols-[.72fr_1.28fr] lg:items-start">
      <div class="space-y-4">
        <div class="rounded-3xl border border-brand-line bg-white p-5 shadow-sm sm:p-6">
          <span class="text-xs font-bold uppercase tracking-[.16em] text-brand-accent-text">Contact SIGNUP</span>
          <h2 class="mt-2 text-xl font-black sm:text-2xl">Choose the right channel.</h2>
          <p class="mt-2 text-sm leading-5 text-brand-muted">For general applicant enquiries, start with our main information or support inboxes.</p>
          <div class="mt-4 space-y-2">
            <a href="mailto:info@signupvisa.com" class="flex items-center justify-between rounded-2xl bg-brand-surface px-4 py-2.5 text-xs font-bold transition hover:bg-brand-accent-bg sm:text-sm"><span>General enquiries</span><span class="text-brand-blue">info@signupvisa.com</span></a>
            <a href="mailto:support@signupvisa.com" class="flex items-center justify-between rounded-2xl bg-brand-surface px-4 py-2.5 text-xs font-bold transition hover:bg-brand-accent-bg sm:text-sm"><span>Support</span><span class="text-brand-blue">support@signupvisa.com</span></a>
            <a href="mailto:admissions@signupvisa.com" class="flex items-center justify-between rounded-2xl bg-brand-surface px-4 py-2.5 text-xs font-bold transition hover:bg-brand-accent-bg sm:text-sm"><span>Admissions</span><span class="text-brand-blue">admissions@signupvisa.com</span></a>
            <a href="mailto:processing@signupvisa.com" class="flex items-center justify-between rounded-2xl bg-brand-surface px-4 py-2.5 text-xs font-bold transition hover:bg-brand-accent-bg sm:text-sm"><span>Processing</span><span class="text-brand-blue">processing@signupvisa.com</span></a>
          </div>
        </div>

        <div class="rounded-3xl border border-brand-line bg-brand-surface p-5 sm:p-6">
          <span class="text-xs font-bold uppercase tracking-[.16em] text-brand-accent-text">Other enquiries</span>
          <div class="mt-3 grid gap-2 text-sm sm:grid-cols-2 lg:grid-cols-1">
            <a href="mailto:partners@signupvisa.com" class="rounded-xl bg-white px-4 py-2.5 font-bold">Partnerships →</a>
            <a href="mailto:media@signupvisa.com" class="rounded-xl bg-white px-4 py-2.5 font-bold">Media →</a>
            <a href="mailto:careers@signupvisa.com" class="rounded-xl bg-white px-4 py-2.5 font-bold">Careers →</a>
            <a href="mailto:moulvibazar@signupvisa.com" class="rounded-xl bg-white px-4 py-2.5 font-bold">Moulvibazar enquiries →</a>
          </div>
        </div>
      </div>

      <div id="enquiry" class="scroll-mt-[190px]">
        <form id="lead-form" class="rounded-[2rem] border border-brand-line bg-white p-5 shadow-xl sm:p-6">
          <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
            <div>
              <span class="text-xs font-bold uppercase tracking-[.16em] text-brand-accent-text">Start an enquiry</span>
              <h2 class="mt-1.5 text-2xl font-black sm:text-3xl">Request a consultation</h2>
            </div>
            <span class="text-xs font-medium text-brand-muted">Required: name + phone</span>
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="full_name" class="mb-1 block text-sm font-bold">Full name <span aria-hidden="true">*</span></label>
              <input id="full_name" name="full_name" required autocomplete="name" placeholder="Your full name" class="w-full rounded-2xl border border-brand-line bg-brand-surface px-4 py-2.5 text-sm outline-none transition focus:border-brand-blue focus:bg-white" />
            </div>
            <div>
              <label for="phone" class="mb-1 block text-sm font-bold">Phone / WhatsApp <span aria-hidden="true">*</span></label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" placeholder="Your phone number" class="w-full rounded-2xl border border-brand-line bg-brand-surface px-4 py-2.5 text-sm outline-none transition focus:border-brand-blue focus:bg-white" />
            </div>
            <div>
              <label for="email" class="mb-1 block text-sm font-bold">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" class="w-full rounded-2xl border border-brand-line bg-brand-surface px-4 py-2.5 text-sm outline-none transition focus:border-brand-blue focus:bg-white" />
            </div>
            <div>
              <label for="interested_service" class="mb-1 block text-sm font-bold">Service</label>
              <select id="interested_service" name="interested_service" class="w-full rounded-2xl border border-brand-line bg-brand-surface px-4 py-2.5 text-sm outline-none focus:border-brand-blue">
                {services.map((service) => <option value={service.name}>{service.name}</option>)}
                <option value="Not sure yet">Not sure yet</option>
              </select>
            </div>
            <div>
              <label for="interested_destination" class="mb-1 block text-sm font-bold">Preferred destination</label>
              <select id="interested_destination" name="interested_destination" class="w-full rounded-2xl border border-brand-line bg-brand-surface px-4 py-2.5 text-sm outline-none focus:border-brand-blue">
                <option value="">Choose a destination</option>
                {destinations.map((destination) => <option value={destination.name}>{destination.name}</option>)}
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="message" class="mb-1 block text-sm font-bold">Tell us about your plans</label>
              <textarea id="message" name="message" rows="3" placeholder="For example: your current education/work background, intended destination and what you want to do abroad." class="w-full resize-y rounded-2xl border border-brand-line bg-brand-surface px-4 py-2.5 text-sm outline-none transition focus:border-brand-blue focus:bg-white"></textarea>
            </div>
            <div class="sm:col-span-2">
              <button id="lead-submit" type="submit" class="group w-full rounded-full bg-gradient-brand px-6 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-brand-blue/20 transition hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-70 disabled:hover:translate-y-0"><span id="lead-submit-text">Send My Consultation Request</span> <span id="lead-submit-arrow" class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span></button>
              <p id="form-help" class="mt-2 text-xs leading-5 text-brand-muted">What happens next? Submit your enquiry and SIGNUP will review the information you provide. You'll see a confirmation on this page when your request has been successfully submitted. If there is a problem sending it, we'll let you know what to do next.</p>
              <p id="form-status" class="mt-2 min-h-5 text-sm" role="status" aria-live="polite"></p>
              <p class="mt-1 text-xs leading-5 text-brand-muted">By submitting this form, you are asking SIGNUP to review your enquiry. A consultation does not guarantee a visa or migration outcome.</p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="border-y border-brand-line bg-brand-surface py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid gap-5 sm:grid-cols-3">
        <div class="rounded-3xl bg-white p-6"><span class="text-xs font-black tracking-[.16em] text-brand-accent-text">01</span><h3 class="mt-4 font-extrabold">Share your goal</h3><p class="mt-2 text-sm leading-6 text-brand-muted">Tell us your preferred service, destination and current situation.</p></div>
        <div class="rounded-3xl bg-white p-6"><span class="text-xs font-black tracking-[.16em] text-brand-accent-text">02</span><h3 class="mt-4 font-extrabold">Understand the pathway</h3><p class="mt-2 text-sm leading-6 text-brand-muted">Use the conversation to clarify relevant requirements and next steps.</p></div>
        <div class="rounded-3xl bg-white p-6"><span class="text-xs font-black tracking-[.16em] text-brand-accent-text">03</span><h3 class="mt-4 font-extrabold">Prepare responsibly</h3><p class="mt-2 text-sm leading-6 text-brand-muted">Move forward with the documents and application preparation relevant to your case.</p></div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('lead-form') as HTMLFormElement | null;
    const help = document.getElementById('form-help') as HTMLParagraphElement | null;
    const status = document.getElementById('form-status') as HTMLParagraphElement | null;
    const submitButton = document.getElementById('lead-submit') as HTMLButtonElement | null;
    const submitText = document.getElementById('lead-submit-text');
    const submitArrow = document.getElementById('lead-submit-arrow');
    const defaultButtonClasses = ['bg-gradient-brand', 'shadow-lg', 'shadow-brand-blue/20'];
    const successButtonClasses = ['bg-emerald-600', 'shadow-lg', 'shadow-emerald-600/20'];

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      status.textContent = 'Sending...';
      status.className = 'mt-3 min-h-5 text-sm text-brand-muted';
      if (help) help.textContent = 'Sending your enquiry now. Please wait for the submission to be confirmed.';
      if (submitButton) submitButton.disabled = true;
      if (submitText) submitText.textContent = 'Sending Request…';
      if (submitArrow) submitArrow.classList.remove('group-hover:translate-x-1');
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const response = await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (!response.ok) throw new Error('Request failed');
        status.textContent = 'Thanks — your consultation request has been received.';
        status.className = 'mt-3 min-h-5 text-sm font-semibold text-brand-success-text';
        if (help) help.textContent = '✓ Your enquiry has been submitted successfully. SIGNUP can now review your details and follow up using the contact information you provided.';
        form.reset();
        if (submitButton) {
          submitButton.classList.remove(...defaultButtonClasses);
          submitButton.classList.add(...successButtonClasses);
          submitButton.disabled = true;
        }
        if (submitText) submitText.textContent = '✓ Request Submitted Successfully';
        if (submitArrow) submitArrow.classList.add('hidden');
      } catch {
        status.textContent = 'We could not send the request. Please try again.';
        status.className = 'mt-3 min-h-5 text-sm font-semibold text-red-600';
        if (help) help.textContent = 'Your enquiry was not submitted. Please try again. If the problem continues, email info@signupvisa.com directly.';
        if (submitButton) {
          submitButton.classList.remove(...successButtonClasses);
          submitButton.classList.add(...defaultButtonClasses);
          submitButton.disabled = false;
        }
        if (submitText) submitText.textContent = 'Send My Consultation Request';
        if (submitArrow) {
          submitArrow.classList.remove('hidden');
          submitArrow.classList.add('group-hover:translate-x-1');
        }
      }
    });
  </script>
</SiteLayout>
