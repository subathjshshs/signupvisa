---
import Layout from '../../layouts/SiteLayout.astro';
import { getSiteSettings } from '../../data/site-config';

const settings = getSiteSettings();
const { slug } = Astro.params;

// Blog content is managed on Blogger. Keep legacy /blog/:slug URLs from
// rendering stale D1 content; send visitors to the live Blogger archive.
if (slug) return Astro.redirect(`https://blog.signupvisa.com/`);
return Astro.redirect('/blog');
---
<Layout title="Blog" settings={settings} />
