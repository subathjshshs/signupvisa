---
import SiteLayout from '../../layouts/SiteLayout.astro';
import BloggerLatest from '../../components/BloggerLatest.astro';
import { getSiteSettings } from '../../data/site-config';

const settings = getSiteSettings();
---
<SiteLayout title="Blog" description="Visa, migration, study abroad and international travel insights from SIGNUP Visa & Migration." settings={settings}>
  <section class="bg-brand-surface py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-5 text-center sm:px-8">
      <span class="rounded-full bg-brand-accent-bg px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-accent-text">SIGNUP Blog</span>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl">Visa & migration insights</h1>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-brand-muted">Practical updates, guidance and international journey insights published on the SIGNUP blog.</p>
    </div>
  </section>
  <BloggerLatest limit={12} heading="Latest articles" compact={true} />
</SiteLayout>
