---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getSiteSettings } from '../data/site-config';
import { testimonials } from '../data/testimonials';

const settings = getSiteSettings();
---
<SiteLayout title="Success Stories" description="Verified client and student stories from SIGNUP Visa & Migration." settings={settings}>
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="text-center">
      <span class="rounded-full bg-brand-accent-bg px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-accent-text">Success Stories</span>
      <h1 class="mt-3 text-3xl font-extrabold sm:text-4xl">Stories from people we have helped</h1>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-brand-muted sm:text-base">We only publish testimonials that have been provided and verified. New stories will appear here as they become available.</p>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t) => (
        <article class="rounded-2xl border border-brand-line bg-white p-6 transition-shadow hover:shadow-lg">
          {t.photo_url && <img src={t.photo_url} alt={t.student_name} loading="lazy" class="mb-4 h-16 w-16 rounded-full object-cover" />}
          <p class="text-sm leading-6 text-brand-ink">“{t.quote}”</p>
          <div class="mt-4 text-sm font-bold">{t.student_name}</div>
          {t.destination && <div class="text-xs text-brand-muted">{t.destination}</div>}
        </article>
      ))}
      {testimonials.length === 0 && <div class="rounded-2xl border border-dashed border-brand-line bg-brand-surface p-8 text-center sm:col-span-2 lg:col-span-3"><p class="text-sm font-semibold text-brand-ink">Verified stories will be published here.</p><p class="mt-2 text-sm text-brand-muted">No unverified names, ratings or outcomes are displayed.</p></div>}
    </div>
  </section>
</SiteLayout>
