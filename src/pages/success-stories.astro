---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getSettings, getTestimonials } from '../lib/content';
import { TEAM_IMAGES, resolveImage } from '../lib/images';
import { env } from 'cloudflare:workers';

const db = (env as any).DB;
const settings = db ? await getSettings(db) : {};
const testimonials = db ? await getTestimonials(db, 50) : [];
---
<SiteLayout title="Success Stories" settings={settings}>
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="text-center">
      <span class="rounded-full bg-brand-accent-bg px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-accent-text">Success Stories</span>
      <h1 class="mt-3 text-3xl font-extrabold sm:text-4xl">Real students, real journeys</h1>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-3">
      {testimonials.map((t: any) => {
        const photo = resolveImage(TEAM_IMAGES, t.student_name) || t.photo_url;
        return (
          <div class="group rounded-2xl border border-brand-line bg-white p-6 transition-shadow hover:shadow-lg">
            {photo && (
              <div class="mb-4 h-16 w-16 overflow-hidden rounded-full border-2 border-brand-line">
                <img src={photo} alt={t.student_name} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110" onerror="this.parentElement.style.display='none'" />
              </div>
            )}
            <p class="text-sm text-brand-ink">"{t.quote}"</p>
            <div class="mt-4 text-sm font-bold">{t.student_name}</div>
            {t.destination && <div class="text-xs text-brand-muted">{t.destination}</div>}
          </div>
        );
      })}
      {testimonials.length === 0 && <p class="text-center text-sm text-brand-muted sm:col-span-3">Testimonials will appear here once added.</p>}
    </div>
  </section>
</SiteLayout>
