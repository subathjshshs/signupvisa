---
import Layout from '../../layouts/Layout.astro';
import { getSettings, getServiceBySlug } from '../../lib/content';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
const db = (env as any).DB;
const settings = db ? await getSettings(db) : {};
const service = db && slug ? await getServiceBySlug(db, slug) : null;

if (!service) {
  return Astro.redirect('/services');
}
---
<Layout title={service.name} settings={settings}>
  <section class="section">
    <div class="container narrow">
      <span class="eyebrow">Service</span>
      <h1>{service.name}</h1>
      <p class="tagline">{service.tagline}</p>
      {service.image_url && <img src={service.image_url} alt={service.name} class="hero-img" />}
      <div class="prose">
        <p>{service.description}</p>
      </div>
      <a href="/contact" class="btn btn-primary" style="margin-top:24px;">Book a Free Consultation</a>
    </div>
  </section>
</Layout>
<style>
  .narrow { max-width: 760px; }
  .tagline { color: var(--text-muted); font-size: 1.1rem; margin-top: 8px; }
  .hero-img { border-radius: var(--radius); margin: 28px 0; aspect-ratio: 16/9; object-fit: cover; }
  .prose p { font-size: 1.05rem; }
</style>
