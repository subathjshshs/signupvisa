---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { services } from '../../data/services';
import { getSiteSettings } from '../../data/site-config';

const settings = getSiteSettings();
---
<SiteLayout title="Visa & Migration Services" description="Explore student visa, work permit, skilled migration and visit visa services from SIGNUP Visa & Migration." settings={settings}>
  <main>
    <section class="relative overflow-hidden bg-brand-surface">
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_85%_15%,rgba(26,86,219,0.14),transparent_34%),radial-gradient(circle_at_5%_85%,rgba(124,58,237,0.10),transparent_32%)]"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-5 py-16 sm:py-24 lg:grid-cols-[1.05fr_.95fr] lg:gap-16">
        <div class="lg:-translate-y-10">
          <a href="/" class="inline-flex items-center text-sm font-semibold text-brand-muted transition hover:text-brand-blue">← Back to home</a>
          <span class="mt-6 inline-flex rounded-full border border-brand-accent-text/15 bg-brand-accent-bg px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-brand-accent-text">Visa & Migration Services</span>
          <h1 class="mt-5 max-w-3xl text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">One clear place for your <span class="text-gradient">next pathway.</span></h1>
          <p class="mt-5 max-w-2xl text-base leading-7 text-brand-muted sm:text-lg">Whether your goal is to study, work, visit or explore skilled migration, start by understanding the pathway and requirements that apply to your situation.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/contact#enquiry" class="rounded-full bg-gradient-brand px-7 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-blue/20 transition hover:-translate-y-0.5">Book a Consultation →</a>
            <a href="/destinations" class="rounded-full border border-brand-line bg-white px-7 py-3.5 text-sm font-bold text-brand-ink transition hover:border-brand-blue">Explore Destinations</a>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          {services.map((service, index) => (
            <a href={`/services/${service.slug}`} class={`group relative overflow-hidden rounded-2xl border border-white/80 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl ${index === 0 ? 'col-span-2' : ''}`}>
              <div class={`relative overflow-hidden ${index === 0 ? 'aspect-[16/7]' : 'aspect-[4/3]'}`}>
                <img src={service.imageUrl} alt={service.name} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
                <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3 text-white">
                  <div><span class="text-xl" aria-hidden="true">{service.icon}</span><h2 class="mt-1 text-base font-extrabold sm:text-lg">{service.name}</h2></div>
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/15 text-lg backdrop-blur transition group-hover:bg-white group-hover:text-brand-blue" aria-hidden="true">→</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-brand-line bg-white">
      <div class="mx-auto grid max-w-7xl gap-px bg-brand-line px-5 md:grid-cols-3">
        <div class="bg-white py-7 md:pr-8"><p class="text-sm font-extrabold">Understand your pathway</p><p class="mt-1 text-sm leading-6 text-brand-muted">Start with the route that matches your goal.</p></div>
        <div class="bg-white py-7 md:px-8"><p class="text-sm font-extrabold">Prepare with structure</p><p class="mt-1 text-sm leading-6 text-brand-muted">Organise requirements and supporting documents.</p></div>
        <div class="bg-white py-7 md:pl-8"><p class="text-sm font-extrabold">Move forward clearly</p><p class="mt-1 text-sm leading-6 text-brand-muted">Know the next step before you proceed.</p></div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 sm:py-24">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-accent-text">Our core services</span>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Choose the service that matches your goal.</h2>
        <p class="mt-4 text-sm leading-7 text-brand-muted sm:text-base">Each pathway has different eligibility rules and documentation. Explore the service first, then contact us to discuss your individual circumstances.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {services.map((service, index) => (
          <a href={`/services/${service.slug}`} class="group grid gap-5 rounded-3xl border border-brand-line bg-white p-4 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:grid-cols-[190px_1fr] sm:p-5">
            <div class="overflow-hidden rounded-2xl bg-brand-surface">
              <img src={service.imageUrl} alt="" loading="lazy" decoding="async" class="aspect-[4/3] h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            </div>
            <div class="flex flex-col justify-center py-1">
              <span class="text-2xl" aria-hidden="true">{service.icon}</span>
              <h3 class="mt-3 text-xl font-extrabold">{service.name}</h3>
              <p class="mt-1 text-sm font-semibold text-brand-accent-text">{service.tagline}</p>
              <p class="mt-3 text-sm leading-6 text-brand-muted">{service.description}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-brand-blue">Explore pathway <span class="transition-transform group-hover:translate-x-1">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="px-5 pb-16 sm:pb-24">
      <div class="mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-brand-ink px-7 py-10 text-white sm:px-12 sm:py-14">
        <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-white/60">Need help choosing?</span>
            <h2 class="mt-3 max-w-2xl text-2xl font-extrabold sm:text-3xl">Tell us where you want to go and what you want to do.</h2>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-white/70">We can help you understand which service and destination options are relevant before you begin preparing an application.</p>
          </div>
          <a href="/contact#enquiry" class="inline-flex justify-center rounded-full bg-white px-7 py-3.5 text-sm font-bold text-brand-ink transition hover:-translate-y-0.5">Start Your Enquiry →</a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
