---
import Layout from '../../layouts/Layout.astro';
import { getSettings, getServices } from '../../lib/content';

const db = Astro.locals.runtime?.DB;
const settings = db ? await getSettings(db) : {};
const services = db ? await getServices(db) : [];
---
<Layout title="Services" settings={settings}>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h1>How we help you get there</h1>
      <p class="lead">We currently focus on student visa processing, with work visas, skilled migration, and visit visas coming soon.</p>
      <div class="grid-3" style="margin-top:44px;">
        {services.map((s: any) => (
          <a href={`/services/${s.slug}`} class="card">
            <h3>{s.name}</h3>
            <p>{s.tagline}</p>
            <span class="card-link">Learn more →</span>
          </a>
        ))}
        {services.length === 0 && <div class="card"><p>No services added yet — add them from the admin panel.</p></div>}
      </div>
    </div>
  </section>
</Layout>
<style>
  .lead { color: var(--text-muted); max-width: 60ch; margin-top: 12px; }
  .card-link { display:inline-block; margin-top:14px; font-size:0.85rem; color: var(--gold); font-weight:600; }
</style>
